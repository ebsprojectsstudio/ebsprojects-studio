---
/**
 * The studio mark, from the original site's own asset (459x177, white on
 * transparent). The original shows it at 60x23; it is set larger here, at
 * the studio's request.
 */
import { url } from '../lib/url';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<img
  class:list={['logo', className]}
  src={url('/brand/logo.png')}
  alt="ebs:projects"
  width="459"
  height="177"
  decoding="async"
/>

<style>
  .logo {
    display: block;
    width: auto;
    height: 32px;
  }

  @media (max-width: 809.98px) {
    .logo { height: 27px; }
  }
</style>
