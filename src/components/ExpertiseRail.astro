---
/**
 * The expertises, as a horizontal rail of columns with a scroll hint and
 * arrows, measured off the original site.
 */
import { getCollection, render } from 'astro:content';
import Reveal from './Reveal.astro';
import SplitText from './SplitText.astro';
import { url } from '../lib/url';

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.order - b.data.order);
const expertiseBodies = await Promise.all(
  expertises.map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
);
---

<section class="section expertises r-sect" id="expertises" data-reveal>
  <div class="wrap">
    <Reveal class="section-head">
      <SplitText as="h2" text="Expertises" class="label--section" />
      <button class="expertises__hint" type="button" data-rail-hint>
        <span data-rail-hint-label>Faites défiler</span>
        <svg width="12" height="9" viewBox="0 0 12 9" fill="none" aria-hidden="true">
          <path d="M0 4.5h10.5M7 1l3.5 3.5L7 8" stroke="currentColor" stroke-width="1.1" />
        </svg>
      </button>
    </Reveal>
  </div>

  <div class="rail-wrap">
    <ul class="rail" data-rail>
      {
        expertiseBodies.map(({ entry, Content }) => (
          <li class="rail__item r-20" data-reveal>
            <a class="expertise" href={url(`/projects/expertises/${entry.id}`)}>
              <p class="expertise__index">{entry.data.index}</p>
              <h3 class="expertise__title">{entry.data.title}</h3>
              <div class="expertise__body">
                <Content />
              </div>
              <span class="expertise__go" aria-hidden="true">
                <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                  <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
              <span class="visually-hidden">Voir les projets</span>
            </a>
          </li>
        ))
      }
    </ul>

    <button class="rail__nav rail__nav--prev" type="button" data-rail-prev hidden>
      <span class="visually-hidden">Colonnes précédentes</span>
      <svg width="11" height="18" viewBox="0 0 11 18" fill="none" aria-hidden="true">
        <path d="M9.5 1 1.5 9l8 8" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
    <button class="rail__nav rail__nav--next" type="button" data-rail-next>
      <span class="visually-hidden">Colonnes suivantes</span>
      <svg width="11" height="18" viewBox="0 0 11 18" fill="none" aria-hidden="true">
        <path d="M1.5 1l8 8-8 8" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
  </div>
</section>

<style>
  /* --- Expertises rail --------------------------------------------------- */

  /* The rail and the heading below it touch on the original. */
  .expertises { padding-bottom: 0; }

  .expertises__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.35rem 0;
    background: none;
    border: 0;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color 0.3s var(--ease);
  }
  .expertises__hint:hover { color: var(--fg); }
  .expertises__hint svg { transition: transform 0.45s var(--ease); }
  .expertises__hint:hover svg { transform: translateX(4px); }
  .expertises__hint[data-back] svg { transform: scaleX(-1); }
  .expertises__hint[data-back]:hover svg { transform: scaleX(-1) translateX(4px); }

  .rail-wrap { position: relative; }

  .rail {
    display: flex;
    gap: 60px;
    padding-inline: var(--gutter);
    overflow-x: auto;
    /* No snapping: it would auto-scroll past the left gutter on load. */
    scrollbar-width: none;
    /* The columns fade from halfway across the content to 10% at its right
       edge, as on the original (stops at 47.5% and 95% of the content
       width, measured on ebsprojects.studio). The rail runs edge to edge,
       so the stops are offset by the gutter. */
    --fade: linear-gradient(
      90deg,
      #000 calc(var(--gutter) + (100% - 2 * var(--gutter)) * 0.475),
      rgba(0, 0, 0, 0.1) calc(var(--gutter) + (100% - 2 * var(--gutter)) * 0.95)
    );
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
  }
  .rail::-webkit-scrollbar { display: none; }

  /* 257px, whatever the window width — measured at 1440 and 1726. */
  .rail__item { flex: 0 0 257px; }

  .expertise {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 350px;
  }

  .expertise__index {
    font-size: 0.8125rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.5rem;
  }

  .expertise__title {
    font-size: 1.125rem;
    font-weight: 400;
    margin-bottom: 1.15rem;
    transition: opacity 0.35s var(--ease);
  }

  .expertise__body {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--fg-muted);
    flex: 1;
  }

  .expertise__body :global(p) { margin: 0; }

  /* A 32px round button holding a right arrow, as on the original. */
  .expertise__go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-top: auto;
    border-radius: 50%;
    background: var(--surface);
    color: var(--fg-muted);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
  }

  .expertise__go svg { transition: transform 0.45s var(--ease); }

  .expertise:hover .expertise__title { opacity: 0.6; }
  .expertise:hover .expertise__go { background: var(--surface-hover); color: var(--fg); }
  .expertise:hover .expertise__go svg { transform: translateX(3px); }

  .rail__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .rail__nav:hover { color: var(--fg); }
  .rail__nav[hidden] { display: none; }
  .rail__nav--prev { left: calc(var(--gutter) - 44px); }
  .rail__nav--next { right: calc(var(--gutter) - 30px); }

  @media (max-width: 809.98px) {
    .rail { -webkit-mask-image: none; mask-image: none; }
    .rail__nav { display: none; }
  }

</style>

<script>
  /* --- Hint, wheel and arrows ---------------------------------------------- */
  const init = () => {
    const rail = document.querySelector<HTMLElement>('[data-rail]');
    const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
    const hint = document.querySelector<HTMLButtonElement>('[data-rail-hint]');
    const hintLabel = document.querySelector<HTMLElement>('[data-rail-hint-label]');

    if (rail) {
      /** One column plus its gap. */
      const step = () => {
        const item = rail.querySelector<HTMLElement>('.rail__item');
        return item ? item.getBoundingClientRect().width + 60 : rail.clientWidth * 0.8;
      };
      const atEnd = () => Math.ceil(rail.scrollLeft + rail.clientWidth) >= rail.scrollWidth - 2;

      const sync = () => {
        const start = rail.scrollLeft <= 2;
        const end = atEnd();
        prev?.toggleAttribute('hidden', start);
        next?.toggleAttribute('hidden', end);
        // Once the last column is in view, the hint offers the way back.
        hint?.toggleAttribute('data-back', end);
        if (hintLabel) hintLabel.textContent = end ? 'Revenir au début' : 'Faites défiler';
      };

      prev?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
      next?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
      hint?.addEventListener('click', () => {
        if (atEnd()) rail.scrollTo({ left: 0, behavior: 'smooth' });
        else rail.scrollBy({ left: step() * 2, behavior: 'smooth' });
      });

      rail.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync, { passive: true });
      // Fonts and images settle after first paint and change scrollWidth.
      window.addEventListener('load', sync, { once: true });
      sync();

      if (window.matchMedia('(pointer: fine)').matches) {
        rail.addEventListener(
          'wheel',
          (e) => {
            if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
            const start = rail.scrollLeft <= 0;
            // Let the page keep scrolling once the rail reaches either end.
            if ((start && e.deltaY < 0) || (atEnd() && e.deltaY > 0)) return;
            e.preventDefault();
            rail.scrollLeft += e.deltaY;
          },
          { passive: false }
        );
      }
    }
  };

  document.addEventListener('astro:page-load', init);
</script>
