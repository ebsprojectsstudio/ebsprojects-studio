---
/**
 * A wall of photographs behind the title: columns running endlessly, one up,
 * the next down, each at its own pace. Pure CSS — each column holds its set
 * twice and slides by exactly one set, so the loop has no seam.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

/* Every project's cover and first photographs, without repeats, interleaved
   so neighbouring images come from different projects. */
const seen = new Set<string>();
const depth = Math.max(...projects.map((p) => p.data.strip.length));
const pool = Array.from({ length: depth + 1 }, (_, round) =>
  projects.map((p) => (round === 0 ? p.data.cover : p.data.strip[round - 1]))
)
  .flat()
  .filter((img): img is NonNullable<typeof img> => !!img && !seen.has(img.src) && !!seen.add(img.src))
  .slice(0, 36);

const COLUMNS = 6;
const PER_COLUMN = 6;
/** Seconds for one full set to pass; alternated so no two neighbours match. */
const PACE = [78, 96, 70, 104, 84, 92];

const columns = Array.from({ length: COLUMNS }, (_, c) =>
  Array.from({ length: PER_COLUMN }, (_, k) => pool[(c * PER_COLUMN + k * 5 + c) % pool.length])
);
---

<div class="wall" aria-hidden="true">
  {
    columns.map((images, c) => (
      <div class="wall__col" style={`--dur: ${PACE[c]}s; --i: ${c}`}>
        <div class:list={['wall__track', c % 2 === 1 && 'wall__track--down']}>
          {[0, 1].map((copy) =>
            images.map((img, k) => (
              <figure class="wall__item">
                <Image
                  src={img}
                  alt=""
                  widths={[320, 480, 640]}
                  sizes="(max-width: 809px) 34vw, (max-width: 1199px) 21vw, 17vw"
                  quality={78}
                  loading={copy === 0 && k < 3 ? 'eager' : 'lazy'}
                />
              </figure>
            ))
          )}
        </div>
      </div>
    ))
  }
</div>

<style>
  .wall {
    --gap: 14px;
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap);
    padding-inline: var(--gap);
    overflow: hidden;
  }

  /* Dimmed most behind the title, least at the edges. */
  .wall::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 58% 46% at 50% 50%, rgba(22, 22, 22, 0.82), rgba(22, 22, 22, 0.5) 75%),
      linear-gradient(180deg, rgba(22, 22, 22, 0.55), transparent 22%, transparent 78%, rgba(22, 22, 22, 0.7));
    pointer-events: none;
  }

  .wall__col {
    position: relative;
    min-width: 0;
  }

  /* Two copies of the set, plus one trailing gap so each copy is exactly
     half the track. Columns start at different points of their loop. */
  .wall__track {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    padding-bottom: var(--gap);
    animation: wall-up var(--dur) linear infinite;
    animation-delay: calc(var(--dur) * -0.29 * var(--i));
    will-change: transform;
  }

  .wall__track--down { animation-direction: reverse; }

  @keyframes wall-up {
    to { transform: translateY(-50%); }
  }

  .wall__item {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .wall__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Out of sight under the grey panel: stop. */
  :global([data-covered]) .wall__track { animation-play-state: paused; }

  @media (max-width: 1199.98px) {
    .wall { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .wall__col:nth-child(n + 6) { display: none; }
  }

  @media (max-width: 809.98px) {
    .wall { --gap: 10px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .wall__col:nth-child(n + 4) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__track { animation: none; }
  }
</style>
