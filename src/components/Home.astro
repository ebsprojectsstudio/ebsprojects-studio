---
/**
 * The home page, shared by the real one (src/pages/index.astro) and the
 * previews of each opening animation (src/pages/apercu/). In order:
 *
 *   1. the opening animation and its photographs (chosen in the CMS),
 *      whose title fades out as "Selected projects" — an offset grid on a
 *      grey panel — slides over it;
 *   2. a short statement and the clients, scrolling, then the slideshow;
 *   3. expertises (rail) and the process (accordion), as on the original;
 *   4. a closing call to get in touch.
 *
 * The previous home page is kept in git under the tag V1.
 */
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Reveal from './Reveal.astro';
import SplitText from './SplitText.astro';
import ArrowLink from './ArrowLink.astro';
import Hero from './hero/Hero.astro';
import ExpertiseRail from './ExpertiseRail.astro';
import ProcessSteps from './ProcessSteps.astro';
import Showcase from './Showcase.astro';
import { contact, clients } from '../data/site';
import { HERO_STYLES, heroStyles, type HeroStyle } from '../data/hero';
import { url } from '../lib/url';

interface Props {
  /** Overrides the animation chosen in the CMS — used by the previews. */
  variant?: HeroStyle;
  /** Marks the page as a preview: not indexed, with a switcher. */
  preview?: boolean;
}
const { variant: forced, preview = false } = Astro.props;

type Project = CollectionEntry<'projects'>;

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byId = new Map(projects.map((p) => [p.id, p]));
const pick = (id: string) => {
  const p = byId.get(id);
  if (!p) throw new Error(`home.md names a project that does not exist: "${id}"`);
  return p;
};

const variant = forced ?? home.data.hero.style;
const heroSlides = home.data.hero.slides.length
  ? home.data.hero.slides.map((s) => ({ project: pick(s.project.id), image: s.image }))
  : projects.map((p) => ({ project: p, image: p.data.cover }));

const selected = home.data.selected.map((ref) => pick(ref.id));


/** The photograph shown in the mosaic. */
const main = (p: Project): ImageMetadata => p.data.homeImage ?? p.data.cover;

/** A second photograph, shown when the card is hovered: the one chosen in
    the CMS, or else another photograph of the project. */
const alt = (p: Project): ImageMetadata => {
  if (p.data.homeHoverImage) return p.data.homeHoverImage;
  const pool = [p.data.cover, p.data.thumb, ...p.data.strip, ...p.data.grid.map((g) => g.src)];
  return pool.find((img) => img.src !== main(p).src) ?? main(p);
};

const pad = (n: number) => String(n).padStart(2, '0');

const statement =
  'Directrice artistique et designer graphique à Bordeaux, je crée des projets visuels sur mesure pour marques et institutions, en privilégiant sens, esthétique et impact.';
---

<Base title={preview ? `Aperçu — ${heroStyles[variant].label}` : undefined} noindex={preview}>
  {/*
    The hero stays pinned while "Selected projects" rises over it on a grey
    panel, as on the original site; the title fades out as it comes.
  */}
  <div class="curtain">
    <Hero variant={variant} slides={heroSlides} />

    {/* ------------------------------------------------- Selected projects */}
    <section class="section selected" id="work">
      <div class="wrap">
        <Reveal class="section-head">
          <SplitText as="h2" text="Selected projects" class="label--section" />
          <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
        </Reveal>

        <div class="mosaic">
          {
            selected.map((p, i) => (
              <Reveal class="mosaic__item" delay={(i % 2) * 0.12} data-reveal-at="0.85">
                <a class="scard" href={url(`/projects/${p.id}`)}>
                  <span class="swap scard__media">
                    <span class="swap__inner">
                    <Image
                      src={main(p)}
                      alt={p.data.title}
                      widths={[500, 800, 1240, 1800, 2400]}
                      quality={85}
                      sizes="(max-width: 809px) 96vw, 55vw"
                      style={p.data.homeZoom ? `--zoom:${p.data.homeZoom}` : undefined}
                    />
                    {
                      p.data.homeHoverWhole ? (
                        <span class="swap__alt swap__alt--whole">
                          <Image class="swap__backdrop" src={alt(p)} alt="" widths={[400]} quality={60} sizes="400px" />
                          <Image src={alt(p)} alt="" widths={[500, 800, 1240, 1800, 2400]} quality={85}
                            sizes="(max-width: 809px) 96vw, 55vw" />
                        </span>
                      ) : (
                        <Image
                          class="swap__alt"
                          src={alt(p)}
                          alt=""
                          widths={[500, 800, 1240, 1800, 2400]}
                          quality={85}
                          sizes="(max-width: 809px) 96vw, 55vw"
                        />
                      )
                    }
                    </span>
                  </span>
                  <span class="scard__caption">
                    <span class="scard__title">
                      <span class="scard__index">{pad(i + 1)}</span>
                      <span class="scard__name">{p.data.title}</span>
                    </span>
                    <span class="scard__services">{p.data.services.join(', ')}</span>
                  </span>
                </a>
              </Reveal>
            ))
          }
        </div>

        <Reveal class="more r-20" data-reveal-at="0.85">
          <a class="more__button" href={url('/projects')}>
            <span>Voir tous les projets</span>
            <span class="more__count">({pad(projects.length)})</span>
            <span class="more__disc" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18">
                <path
                  d="M13.922 4.5v7.313a.422.422 0 0 1-.844 0V5.52l-8.283 8.275a.422.422 0 0 1-.59-.59l8.275-8.283H6.187a.422.422 0 0 1 0-.844H13.5c.233 0 .422.189.422.422Z"
                  fill="currentColor"></path>
              </svg>
            </span>
          </a>
        </Reveal>
      </div>
    </section>
  </div>

  {/* -------------------------------------------- Statement + clients */}
  <section class="section studio r-sect" data-reveal>
    <div class="wrap studio__grid">
      <div class="studio__label">
        <SplitText as="p" text="Le studio" class="label--section" />
      </div>
      <div class="studio__body">
        <SplitText
          as="p"
          text={statement}
          preset="body"
          emphasis={['projets visuels sur mesure', 'sens, esthétique et impact']}
          class="studio__statement"
        />
        <Reveal class="studio__facts r-20" delay={0.2}>
          <dl class="facts">
            <div><dt>Basée à</dt><dd>{contact.city}</dd></div>
          </dl>
          <ArrowLink href={url('/contact')}>Travaillons ensemble</ArrowLink>
        </Reveal>
      </div>
    </div>

    <div class="clients" aria-label="Clients">
      <Reveal class="wrap clients__label">
        <SplitText as="p" text="Ils m'ont fait confiance" class="label" />
      </Reveal>
      <Reveal class="marquee r-20" delay={0.1}>
        {
          [0, 1].map((copy) => (
            <ul class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {clients.map((c) => (
                <li class="marquee__item">{c}</li>
              ))}
            </ul>
          ))
        }
      </Reveal>
    </div>
  </section>

  {/* The slideshow, expertises and process: as on the original site. */}
  <Showcase />

  <ExpertiseRail />

  <ProcessSteps />

  {/* ---------------------------------------------------------------- CTA */}
  <section class="section cta">
    <div class="wrap">
      <Reveal>
        <p class="label cta__kicker">Un projet en tête ?</p>
      </Reveal>
      <a class="cta__link" href={url('/contact')}>
        <SplitText text="Parlons-en" preset="heading" class="display cta__word" />
        <span class="cta__disc" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18">
            <path
              d="M13.922 4.5v7.313a.422.422 0 0 1-.844 0V5.52l-8.283 8.275a.422.422 0 0 1-.59-.59l8.275-8.283H6.187a.422.422 0 0 1 0-.844H13.5c.233 0 .422.189.422.422Z"
              fill="currentColor"></path>
          </svg>
        </span>
      </a>
      <Reveal class="cta__direct r-20" delay={0.3}>
        <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
        <a class="link" href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
      </Reveal>
    </div>
  </section>
  {
    preview && (
      <details class="switcher">
        <summary class="switcher__toggle">
          <span class="switcher__kicker">Aperçu</span>
          <span>{heroStyles[variant].label}</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </summary>
        <ul class="switcher__list">
          {HERO_STYLES.map((s) => (
            <li>
              <a class="switcher__item" href={url(`/apercu/${s}`)} aria-current={s === variant ? 'page' : undefined}>
                {heroStyles[s].label}
              </a>
            </li>
          ))}
          <li>
            <a class="switcher__item switcher__item--all" href={url('/apercu')}>
              Toutes les animations
            </a>
          </li>
        </ul>
      </details>
    )
  }
</Base>

<style>
  /* --- Curtain ------------------------------------------------------------
     The hero is pinned (sticky, in Hero.astro) and publishes its scroll
     progress as --hp, 0 -> 1 over the first screen. "Selected projects"
     rises over it on its grey panel, as on the original site, while the title and the
     photographs of the opening fade out. */

  .curtain { position: relative; }

  /* The grey panel that rises over the pinned hero, as on the original site. */
  .selected {
    position: relative;
    z-index: 1;
    padding-top: var(--section-y);
    background: var(--bg-panel);
  }

  /* No blur here: the opening screen — photographs and title — sinks into
     black as the page scrolls, a veil that deepens until it is opaque by
     the time the projects reach the middle of the screen. */
  .curtain :global(.hero__stage) {
    filter: none;
    opacity: 1;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .curtain :global([data-hero])::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #000;
    opacity: clamp(0, calc(var(--hp, 0) * 1.4), 1);
    pointer-events: none;
    /* The scroll position arrives in steps (a wheel notch, a trackpad
       flick); easing each change makes the darkening glide between them. */
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity;
  }

  .curtain :global(.hero__inner) {
    transform: translateY(calc(var(--hp, 0) * -6vh));
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .curtain :global(.badge) { opacity: clamp(0, calc(1 - var(--hp, 0) * 3), 1); }

  .count {
    margin-left: 0.5em;
    white-space: nowrap;
    color: var(--fg-dim);
  }

  /* --- Image swap on hover ------------------------------------------------ */

  .swap {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-raised);
  }

  /* Each photograph settles in its frame as its card comes into view —
     the same gesture as the slideshow's slides (1.08 -> 1). */
  .swap__inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(1.15);
    transition: transform 1.8s var(--spring-smooth) calc(0.15s + var(--reveal-delay, 0s));
  }

  :global(.is-visible) > .scard .swap__inner,
  :global(html.no-js) .swap__inner { transform: none; }

  .swap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--spring-smooth);
  }

  /* The second photograph wipes up from below rather than fading, so the
     change reads as deliberate. */
  .swap :global(.swap__alt) {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0);
    transform: scale(1.06);
    transition:
      clip-path 0.9s var(--spring-smooth),
      transform 1.2s var(--spring-smooth);
  }

  a:hover .swap :global(.swap__alt),
  a:focus-visible .swap :global(.swap__alt) {
    clip-path: inset(0 0 0 0);
    transform: none;
  }

  a:hover .swap__inner > :global(img:not(.swap__alt)) { transform: scale(1.04); }

  /* A hover photograph shown whole (homeHoverWhole): contained, over a
     blurred, enlarged copy of itself that fills the rest of the card. */
  .swap :global(.swap__alt--whole) { display: block; overflow: hidden; }
  .swap :global(.swap__alt--whole img) {
    position: absolute;
    inset: 0;
    object-fit: contain;
  }
  .swap :global(.swap__alt--whole .swap__backdrop) {
    object-fit: cover;
    filter: blur(28px) brightness(0.8);
    transform: scale(1.2);
  }

  /* A per-project zoom (homeZoom), on its own property so it stacks with
     the hover and fade-in transforms instead of being replaced by them. */
  .swap__inner > :global(img:not(.swap__alt)) { scale: var(--zoom, 1); }

  /* --- Studio statement --------------------------------------------------- */

  .studio { padding-top: clamp(4rem, 9vw, 8rem); }

  .studio__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .studio :global(.studio__label) { grid-column: 1 / span 3; }

  .studio__body { grid-column: 4 / -1; }

  .studio :global(.studio__statement) {
    font-size: clamp(1.25rem, 2vw, 1.875rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--fg-muted);
  }

  .studio :global(.studio__facts) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .facts {
    display: flex;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin: 0;
  }

  .facts dt {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .facts dd {
    margin: 0.35rem 0 0;
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* --- Clients marquee ---------------------------------------------------- */

  .clients { margin-top: clamp(4rem, 8vw, 7rem); }

  .clients :global(.clients__label) { display: block; margin-bottom: 1.5rem; }

  .marquee {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--line-soft);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__group {
    display: flex;
    flex: none;
    animation: marquee 38s linear infinite;
  }

  .marquee:hover .marquee__group { animation-play-state: paused; }

  .marquee__item {
    display: flex;
    align-items: center;
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    font-size: clamp(1.25rem, 2.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.28);
    transition: color 0.4s var(--ease);
  }

  .marquee__item:hover { color: var(--fg); }

  .marquee__item::after {
    content: '';
    width: 0.18em;
    height: 0.18em;
    margin-inline: 0.6em;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
  }

  @keyframes marquee {
    to { transform: translateX(-100%); }
  }

  /* --- Selected projects: offset mosaic ---------------------------------- */

  /* Two rows that answer each other:

       1  large 3:2, left, high   2  narrow 4:5, right, low
       3  medium 4:3, left, raised 4  large 5:4, right, low

     The third is pulled up into the space under the first, which the
     dropped second card would otherwise leave empty.                       */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(2.5rem, 4.5vw, 4rem);
    align-items: start;
  }

  .mosaic :global(.mosaic__item) {
    grid-column: var(--col);
    margin-top: var(--drop, 0);
  }

  .mosaic :global(.mosaic__item:nth-child(4n + 1)) { --col: 1 / span 7; --ratio: 3 / 2; }
  .mosaic :global(.mosaic__item:nth-child(4n + 2)) { --col: 9 / span 4; --ratio: 4 / 5; --drop: clamp(3rem, 9vw, 8rem); }
  .mosaic :global(.mosaic__item:nth-child(4n + 3)) { --col: 1 / span 5; --ratio: 4 / 3; --drop: calc(-1 * clamp(2.5rem, 7vw, 7rem)); }
  .mosaic :global(.mosaic__item:nth-child(4n))     { --col: 7 / span 6; --ratio: 5 / 4; --drop: clamp(3rem, 9vw, 8rem); }

  /* Each card measures itself, so a narrow one can stack its caption. */
  .scard {
    display: block;
    container-type: inline-size;
  }

  /* The photograph is unveiled from the bottom as the card is scrolled to,
     and settles from a little large (.swap__inner, above). */
  .scard__media {
    aspect-ratio: var(--ratio, 4 / 3);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.3s var(--spring-smooth) calc(0.15s + var(--reveal-delay, 0s));
  }

  :global(.is-visible) > .scard .scard__media,
  :global(html.no-js) .scard__media { clip-path: inset(0 0 0 0); }

  /* Number and title on the left, expertises on the right. */
  .scard__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    margin-top: 20px;
  }

  /* Same type as the original site's project captions. The number keeps
     its own column, so a long title wraps under itself, not under it. */
  .scard__title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .scard__index {
    flex: none;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--fg-dim);
    transition: color 0.4s var(--ease);
  }

  /* Hover, quietly: the number lights up and the title edges forward. */
  .scard__name { transition: transform 0.6s var(--spring-smooth); }
  .scard:hover .scard__index { color: var(--fg); }
  .scard:hover .scard__name { transform: translateX(4px); }

  .scard__services {
    flex: none;
    max-width: 50%;
    font-size: 0.875rem;
    text-align: right;
    color: var(--fg-dim);
  }

  /* On a narrow card the two would crowd each other: stack them. */
  @container (max-width: 520px) {
    .scard__caption { flex-direction: column; gap: 0.3rem; }
    .scard__services { max-width: none; text-align: left; }
  }

  /* --- "Voir tous les projets" ----------------------------------------- */

  .selected :global(.more) {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .more__button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.55rem 0.55rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .more__count { color: var(--fg-dim); transition: color 0.4s var(--ease); }

  .more__disc {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease);
  }

  .more__disc svg { transition: transform 0.5s var(--spring-smooth); }

  .more__button:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .more__button:hover .more__count { color: rgba(22, 22, 22, 0.55); }
  .more__button:hover .more__disc { background: var(--bg); color: var(--fg); }
  .more__button:hover .more__disc svg { transform: translate(2px, -2px); }

  /* --- Closing call ------------------------------------------------------- */

  .cta {
    padding-block: clamp(5rem, 12vw, 10rem) clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  .cta__kicker { margin-bottom: 1.25rem; }

  .cta__link {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  /* Title size rather than the hero's display size: a closing line, not
     a second opening. */
  .cta :global(.cta__word) {
    font-size: var(--fs-title);
    display: inline-block;
    transition: letter-spacing 0.8s var(--spring-smooth);
  }

  .cta__link:hover :global(.cta__word) { letter-spacing: -0.045em; }

  .cta__disc {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(40px, 4vw, 60px);
    height: clamp(40px, 4vw, 60px);
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    transition: transform 0.6s var(--spring-smooth);
  }

  .cta__disc svg {
    width: 42%;
    height: 42%;
    transition: transform 0.6s var(--spring-smooth);
  }

  .cta__link:hover .cta__disc { transform: rotate(45deg); }

  .cta :global(.cta__direct) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2.5rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* --- Smaller screens ---------------------------------------------------- */

  @media (max-width: 809.98px) {
    .studio__grid { grid-template-columns: minmax(0, 1fr); row-gap: 1.25rem; }
    .studio :global(.studio__label),
    .studio__body { grid-column: auto; }

    .facts { gap: 1.5rem; }
    .facts dd { font-size: 1.375rem; }

    /* The "see all" links in section heads would crowd the label; every
       project is listed further down anyway. */
    .section-head :global(.arrow-link) { display: none; }

    /* One column, nothing dropped. */
    .mosaic { grid-template-columns: minmax(0, 1fr); }
    .mosaic :global(.mosaic__item:nth-child(n)) { --col: auto; --drop: 0; }



  }

  @media (prefers-reduced-motion: reduce) {
    .swap__inner { transform: none; transition: none; }
    .scard__media { clip-path: none; transition: none; }
    .marquee__group { animation: none; }
    .marquee { overflow-x: auto; }
  }

