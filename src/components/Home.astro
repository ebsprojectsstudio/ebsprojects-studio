---
/**
 * The home page, shared by the real one (src/pages/index.astro) and the
 * previews of each opening animation (src/pages/apercu/).
 */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import Reveal from './Reveal.astro';
import SplitText from './SplitText.astro';
import ArrowLink from './ArrowLink.astro';
import Hero from './hero/Hero.astro';
import ExpertiseRail from './ExpertiseRail.astro';
import ProcessSteps from './ProcessSteps.astro';
import { HERO_STYLES, heroStyles, type HeroStyle } from '../data/hero';
import { url } from '../lib/url';

interface Props {
  /** Overrides the animation chosen in the CMS — used by the previews. */
  variant?: HeroStyle;
  /** Marks the page as a preview: not indexed, with a switcher. */
  preview?: boolean;
}
const { variant: forced, preview = false } = Astro.props;

/* What is featured on the home page is chosen in the CMS
   (src/content/pages/home.md), not flagged on each project. */
const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byId = new Map(projects.map((p) => [p.id, p]));
const pick = (id: string) => {
  const p = byId.get(id);
  if (!p) throw new Error(`home.md names a project that does not exist: "${id}"`);
  return p;
};

const variant = forced ?? home.data.hero.style;
const heroSlides = home.data.hero.slides.length
  ? home.data.hero.slides.map((s) => ({ project: pick(s.project.id), image: s.image }))
  : projects.map((p) => ({ project: p, image: p.data.cover }));

const selected = home.data.selected.map((ref) => pick(ref.id));
const slides = home.data.slider.map((s) => ({ project: pick(s.project.id), image: s.image }));
---

<Base title={preview ? `Aperçu — ${heroStyles[variant].label}` : undefined} noindex={preview}>
  {/*
    The hero is pinned while "Selected projects" slides up over it like a
    curtain, blurring as it goes — both measured off the original.
  */}
  <div class="curtain">
    <Hero variant={variant} slides={heroSlides} />

    {/* --------------------------------------------------- Selected work */}
    <section class="section work" id="work">
      <div class="wrap">
        <Reveal class="section-head">
          <SplitText as="h2" text="Selected projects" class="label--section" />
          <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
        </Reveal>

        <div class="grid">
          {
            selected.map((p, i) => (
              <Reveal delay={(i % 2) * 0.08}>
                <ProjectCard
                  href={url(`/projects/${p.id}`)}
                  title={p.data.title}
                  services={p.data.services}
                  image={p.data.cover}
                  variant="stacked"
                  priority={i < 2}
                />
              </Reveal>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <ExpertiseRail />

  <ProcessSteps />

  {/* --------------------------------------------------------- Showcase */}
  <section class="showcase">
    <div class="wrap">
      <Reveal>
        <div class="slider" data-slider>
          <div class="slider__track" data-slider-track>
            {
              slides.map(({ project: p, image }, i) => (
                <a class="slide" href={url(`/projects/${p.id}`)} data-slide aria-hidden={i > 0 ? 'true' : undefined}>
                  <span class="slide__zoom">
                    <Image
                      src={image}
                      alt={p.data.title}
                      widths={[800, 1280, 1920, 2560, 3200]}
                      quality={85}
                      sizes="(max-width: 809px) 96vw, 90vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      data-fade
                    />
                  </span>
                  <span class="slide__meta">
                    <span class="slide__title">{p.data.title}</span>
                    <span class="slide__services">/ {p.data.services.join(' / ')}</span>
                  </span>
                </a>
              ))
            }
          </div>

          <ArrowLink class="slider__all" href={url('/projects')}>Voir tous les projets</ArrowLink>

          <div class="slider__dots" role="tablist" aria-label="Projets mis en avant">
            {
              slides.map(({ project: p }, i) => (
                <button
                  class="slider__dot"
                  type="button"
                  role="tab"
                  data-slider-dot
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  <span class="visually-hidden">{p.data.title}</span>
                </button>
              ))
            }
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  {
    preview && (
      <details class="switcher">
        <summary class="switcher__toggle">
          <span class="switcher__kicker">Aperçu</span>
          <span>{heroStyles[variant].label}</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </summary>
        <ul class="switcher__list">
          {HERO_STYLES.map((s) => (
            <li>
              <a class="switcher__item" href={url(`/apercu/${s}`)} aria-current={s === variant ? 'page' : undefined}>
                {heroStyles[s].label}
              </a>
            </li>
          ))}
          <li>
            <a class="switcher__item switcher__item--all" href={url('/apercu')}>
              Toutes les animations
            </a>
          </li>
        </ul>
      </details>
    )
  }
</Base>

<style>
  /* --- Curtain: hero pinned, grey section slides over it ------------------ */

  .curtain { position: relative; }

  /* The grey panel that rises over the pinned hero (#1B1B1C on the original). */
  .work {
    position: relative;
    z-index: 1;
    background: var(--bg-panel);
  }

  /* --- Grid -------------------------------------------------------------- */

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }

  /* --- Showcase slider --------------------------------------------------- */

  .showcase { padding-bottom: var(--section-y); }

  .slider { position: relative; }

  /* 793px tall at desktop widths, the width simply filling the page — the
     original keeps the height fixed, so it grows wider, not taller. */
  .slider__track {
    position: relative;
    height: 793px;
    overflow: hidden;
    background: var(--bg-raised);
  }

  @media (max-width: 1199.98px) {
    .slider__track { height: 62vw; }
  }

  @media (max-width: 809.98px) {
    .slider__track { height: auto; aspect-ratio: 4 / 3; }
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s var(--spring-smooth);
  }

  .slide[data-active] {
    opacity: 1;
    pointer-events: auto;
  }

  /* Each photograph settles from slightly large as its slide comes in. */
  .slide__zoom {
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(1.08);
    transition: transform 1.6s var(--spring-smooth);
  }

  .slide[data-active] .slide__zoom { transform: scale(1); }
  .slide[data-active]:hover .slide__zoom { transform: scale(1.03); }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide__meta {
    position: absolute;
    top: 28px;
    left: 32px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .slide__title {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .slide__services {
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.7);
  }

  .showcase :global(.slider__all) {
    position: absolute;
    top: 30px;
    right: 32px;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .slider__dots {
    position: absolute;
    left: 50%;
    bottom: 73px;
    translate: -50% 0;
    display: flex;
    gap: 8px;
  }

  .slider__dot {
    width: 28px;
    height: 6px;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: background-color 0.4s var(--ease);
  }

  .slider__dot:hover { background: rgba(255, 255, 255, 0.55); }
  .slider__dot[aria-selected='true'] { background: var(--fg); }

  @media (max-width: 809.98px) {
    .slide__meta { top: 16px; left: 16px; }
    .slide__title { font-size: 1rem; }
    .slide__services { font-size: 0.875rem; }
    .showcase :global(.slider__all) { display: none; }
    .slider__dots { bottom: 20px; }
  }

  /* --- Preview switcher (only on /apercu/…) -------------------------------
     Folded into a small pill in the corner, clear of the hero's own caption
     and badge; it opens upwards. */

  .switcher {
    position: fixed;
    z-index: 60;
    right: 12px;
    bottom: 12px;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .switcher__toggle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: rgba(22, 22, 22, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .switcher__toggle::-webkit-details-marker { display: none; }

  .switcher__kicker {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-dim);
  }

  .switcher__toggle svg { transition: transform 0.35s var(--ease); }
  .switcher:not([open]) .switcher__toggle svg { transform: rotate(180deg); }

  .switcher__list {
    position: absolute;
    right: 0;
    bottom: calc(100% + 8px);
    min-width: 240px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border: 1px solid var(--line-soft);
    border-radius: 14px;
    background: rgba(22, 22, 22, 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    animation: switcher-in 0.35s var(--spring-smooth);
  }

  @keyframes switcher-in {
    from { opacity: 0; transform: translateY(6px); }
  }

  .switcher__item {
    display: block;
    padding: 0.6rem 0.8rem;
    border-radius: 9px;
    white-space: nowrap;
    color: var(--fg-muted);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .switcher__item:hover { color: var(--fg); background: var(--surface); }
  .switcher__item[aria-current='page'] { color: var(--bg); background: var(--fg); }
  .switcher__item--all { margin-top: 4px; border-top: 1px solid var(--line-soft); border-radius: 0 0 9px 9px; }
</style>

<script>
  /* Module-level handles, so document- and window-level listeners are bound
     once and never pile up across client-side navigations. */
  let sliderTimer = 0;
  let current: { play: () => void; stop: () => void } = { play: () => {}, stop: () => {} };

  document.addEventListener('astro:before-swap', () => {
    current.stop();
    current = { play: () => {}, stop: () => {} };
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) current.stop();
    else current.play();
  });

  const init = () => {
  /* --- Showcase slider ----------------------------------------------------- */
  const slider = document.querySelector<HTMLElement>('[data-slider]');

  if (slider) {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-slider-dot]')];
    const INTERVAL = 3000;
    let index = 0;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.toggleAttribute('data-active', n === index);
        s.setAttribute('aria-hidden', n === index ? 'false' : 'true');
      });
      dots.forEach((d, n) => d.setAttribute('aria-selected', n === index ? 'true' : 'false'));
      // The next slide's photograph is needed within three seconds.
      slides[(index + 1) % slides.length]?.querySelector('img')?.setAttribute('loading', 'eager');
    };

    /* Still advances when motion is reduced — the cross-fade is what gets
       suppressed there, by the global transition override, not the rotation. */
    const play = () => {
      stop();
      if (slides.length > 1) sliderTimer = window.setInterval(() => go(index + 1), INTERVAL);
    };
    const stop = () => {
      if (sliderTimer) clearInterval(sliderTimer);
      sliderTimer = 0;
    };

    dots.forEach((d, n) =>
      d.addEventListener('click', () => {
        go(n);
        play();
      })
    );

    // Don't advance under the reader's cursor.
    slider.addEventListener('pointerenter', stop);
    slider.addEventListener('pointerleave', play);

    current = { play, stop };
    go(0);
    if (!document.hidden) play();
  }
  };

  /* Only via the event: ClientRouter fires `astro:page-load` on the first
     load as well as after each navigation. Calling init() directly too would
     bind every listener twice, and paired handlers would cancel each other. */
  document.addEventListener('astro:page-load', init);
</script>
