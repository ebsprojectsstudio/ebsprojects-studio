---
/**
 * The home page, shared by the real one (src/pages/index.astro) and the
 * previews of each opening animation (src/pages/apercu/).
 */
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import Reveal from './Reveal.astro';
import SplitText from './SplitText.astro';
import ArrowLink from './ArrowLink.astro';
import Hero from './hero/Hero.astro';
import { process } from '../data/site';
import { HERO_STYLES, heroStyles, type HeroStyle } from '../data/hero';
import { url } from '../lib/url';

interface Props {
  /** Overrides the animation chosen in the CMS — used by the previews. */
  variant?: HeroStyle;
  /** Marks the page as a preview: not indexed, with a switcher. */
  preview?: boolean;
}
const { variant: forced, preview = false } = Astro.props;

/* What is featured on the home page is chosen in the CMS
   (src/content/pages/home.md), not flagged on each project. */
const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byId = new Map(projects.map((p) => [p.id, p]));
const pick = (id: string) => {
  const p = byId.get(id);
  if (!p) throw new Error(`home.md names a project that does not exist: "${id}"`);
  return p;
};

const variant = forced ?? home.data.hero.style;
const heroSlides = home.data.hero.slides.length
  ? home.data.hero.slides.map((s) => ({ project: pick(s.project.id), image: s.image }))
  : projects.map((p) => ({ project: p, image: p.data.cover }));

const selected = home.data.selected.map((ref) => pick(ref.id));
const slides = home.data.slider.map((s) => ({ project: pick(s.project.id), image: s.image }));

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.order - b.data.order);
const expertiseBodies = await Promise.all(
  expertises.map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
);
---

<Base title={preview ? `Aperçu — ${heroStyles[variant].label}` : undefined} noindex={preview}>
  {/*
    The hero is pinned while "Selected projects" slides up over it like a
    curtain, blurring as it goes — both measured off the original.
  */}
  <div class="curtain">
    <Hero variant={variant} slides={heroSlides} />

    {/* --------------------------------------------------- Selected work */}
    <section class="section work" id="work">
      <div class="wrap">
        <Reveal class="section-head">
          <SplitText as="h2" text="Selected projects" class="label--section" />
          <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
        </Reveal>

        <div class="grid">
          {
            selected.map((p, i) => (
              <Reveal delay={(i % 2) * 0.08}>
                <ProjectCard
                  href={url(`/projects/${p.id}`)}
                  title={p.data.title}
                  services={p.data.services}
                  image={p.data.cover}
                  variant="stacked"
                  priority={i < 2}
                />
              </Reveal>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {/* ------------------------------------------------------- Expertises */}
  <section class="section expertises r-sect" id="expertises" data-reveal>
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Expertises" class="label--section" />
        <button class="expertises__hint" type="button" data-rail-hint>
          <span data-rail-hint-label>Faites défiler</span>
          <svg width="12" height="9" viewBox="0 0 12 9" fill="none" aria-hidden="true">
            <path d="M0 4.5h10.5M7 1l3.5 3.5L7 8" stroke="currentColor" stroke-width="1.1" />
          </svg>
        </button>
      </Reveal>
    </div>

    <div class="rail-wrap">
      <ul class="rail" data-rail>
        {
          expertiseBodies.map(({ entry, Content }) => (
            <li class="rail__item r-20" data-reveal>
              <a class="expertise" href={url(`/projects/expertises/${entry.id}`)}>
                <p class="expertise__index">{entry.data.index}</p>
                <h3 class="expertise__title">{entry.data.title}</h3>
                <div class="expertise__body">
                  <Content />
                </div>
                <span class="expertise__go" aria-hidden="true">
                  <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                    <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                </span>
                <span class="visually-hidden">Voir les projets</span>
              </a>
            </li>
          ))
        }
      </ul>

      <button class="rail__nav rail__nav--prev" type="button" data-rail-prev hidden>
        <span class="visually-hidden">Colonnes précédentes</span>
        <svg width="11" height="18" viewBox="0 0 11 18" fill="none" aria-hidden="true">
          <path d="M9.5 1 1.5 9l8 8" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
      <button class="rail__nav rail__nav--next" type="button" data-rail-next>
        <span class="visually-hidden">Colonnes suivantes</span>
        <svg width="11" height="18" viewBox="0 0 11 18" fill="none" aria-hidden="true">
          <path d="M1.5 1l8 8-8 8" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
    </div>
  </section>

  {/* ---------------------------------------------------------- Process */}
  <section class="section" id="process">
    <div class="wrap">
      <Reveal>
        <SplitText as="h2" text={"Comment se déroule un projet ?"} class="label--section process__heading" />
      </Reveal>

      <div class="process">
        {
          process.map((step) => (
            <Reveal class="r-30">
              <details class="step" name="process">
                <summary class="step__summary">
                  <span class="step__index" aria-hidden="true">•</span>
                  <span class="step__title">{step.title}</span>
                  <span class="step__icon" aria-hidden="true" />
                </summary>
                <div class="step__panel">
                  <div class="step__inner">
                    <p class="lead">{step.body}</p>
                  </div>
                </div>
              </details>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- Showcase */}
  <section class="showcase">
    <div class="wrap">
      <Reveal>
        <div class="slider" data-slider>
          <div class="slider__track" data-slider-track>
            {
              slides.map(({ project: p, image }, i) => (
                <a class="slide" href={url(`/projects/${p.id}`)} data-slide aria-hidden={i > 0 ? 'true' : undefined}>
                  <span class="slide__zoom">
                    <Image
                      src={image}
                      alt={p.data.title}
                      widths={[800, 1280, 1920, 2560, 3200]}
                      quality={85}
                      sizes="(max-width: 809px) 96vw, 90vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      data-fade
                    />
                  </span>
                  <span class="slide__meta">
                    <span class="slide__title">{p.data.title}</span>
                    <span class="slide__services">/ {p.data.services.join(' / ')}</span>
                  </span>
                </a>
              ))
            }
          </div>

          <ArrowLink class="slider__all" href={url('/projects')}>Voir tous les projets</ArrowLink>

          <div class="slider__dots" role="tablist" aria-label="Projets mis en avant">
            {
              slides.map(({ project: p }, i) => (
                <button
                  class="slider__dot"
                  type="button"
                  role="tab"
                  data-slider-dot
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  <span class="visually-hidden">{p.data.title}</span>
                </button>
              ))
            }
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  {
    preview && (
      <details class="switcher">
        <summary class="switcher__toggle">
          <span class="switcher__kicker">Aperçu</span>
          <span>{heroStyles[variant].label}</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </summary>
        <ul class="switcher__list">
          {HERO_STYLES.map((s) => (
            <li>
              <a class="switcher__item" href={url(`/apercu/${s}`)} aria-current={s === variant ? 'page' : undefined}>
                {heroStyles[s].label}
              </a>
            </li>
          ))}
          <li>
            <a class="switcher__item switcher__item--all" href={url('/apercu')}>
              Toutes les animations
            </a>
          </li>
        </ul>
      </details>
    )
  }
</Base>

<style>
  /* --- Curtain: hero pinned, grey section slides over it ------------------ */

  .curtain { position: relative; }

  /* The grey panel that rises over the pinned hero (#1B1B1C on the original). */
  .work {
    position: relative;
    z-index: 1;
    background: var(--bg-panel);
  }

  /* --- Grid -------------------------------------------------------------- */

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }

  /* --- Expertises rail --------------------------------------------------- */

  /* The rail and the heading below it touch on the original. */
  .expertises { padding-bottom: 0; }
  #process { padding-top: clamp(1.5rem, 3vw, 2.5rem); }

  .expertises__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.35rem 0;
    background: none;
    border: 0;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color 0.3s var(--ease);
  }
  .expertises__hint:hover { color: var(--fg); }
  .expertises__hint svg { transition: transform 0.45s var(--ease); }
  .expertises__hint:hover svg { transform: translateX(4px); }
  .expertises__hint[data-back] svg { transform: scaleX(-1); }
  .expertises__hint[data-back]:hover svg { transform: scaleX(-1) translateX(4px); }

  .rail-wrap { position: relative; }

  .rail {
    display: flex;
    gap: 60px;
    padding-inline: var(--gutter);
    overflow-x: auto;
    /* No snapping: it would auto-scroll past the left gutter on load. */
    scrollbar-width: none;
    /* The last column bleeds off and fades, rather than being clipped. */
    -webkit-mask-image: linear-gradient(90deg, #000 82%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 82%, transparent 100%);
  }
  .rail::-webkit-scrollbar { display: none; }

  /* 257px, whatever the window width — measured at 1440 and 1726. */
  .rail__item { flex: 0 0 257px; }

  .expertise {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 350px;
  }

  .expertise__index {
    font-size: 0.8125rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.5rem;
  }

  .expertise__title {
    font-size: 1.125rem;
    font-weight: 400;
    margin-bottom: 1.15rem;
    transition: opacity 0.35s var(--ease);
  }

  .expertise__body {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--fg-muted);
    flex: 1;
  }

  .expertise__body :global(p) { margin: 0; }

  /* A 32px round button holding a right arrow, as on the original. */
  .expertise__go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-top: auto;
    border-radius: 50%;
    background: var(--surface);
    color: var(--fg-muted);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
  }

  .expertise__go svg { transition: transform 0.45s var(--ease); }

  .expertise:hover .expertise__title { opacity: 0.6; }
  .expertise:hover .expertise__go { background: var(--surface-hover); color: var(--fg); }
  .expertise:hover .expertise__go svg { transform: translateX(3px); }

  .rail__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .rail__nav:hover { color: var(--fg); }
  .rail__nav[hidden] { display: none; }
  .rail__nav--prev { left: calc(var(--gutter) - 44px); }
  .rail__nav--next { right: calc(var(--gutter) - 30px); }

  @media (max-width: 809.98px) {
    .rail { -webkit-mask-image: none; mask-image: none; }
    .rail__nav { display: none; }
  }

  /* --- Process ----------------------------------------------------------- */

  .process__heading {
    display: block;
    max-width: none;
    font-weight: 500;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .process { border-top: 1px solid var(--line-soft); }

  .step { border-bottom: 1px solid var(--line-soft); }

  .step__summary {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-block: clamp(1rem, 1.9vw, 1.4rem);
    cursor: pointer;
    list-style: none;
    transition: color 0.3s var(--ease);
  }
  .step__summary::-webkit-details-marker { display: none; }

  /* A faint wash bleeding into the gutters, so the whole row reads as the
     target rather than just the words. */
  .step__summary::before {
    content: '';
    position: absolute;
    inset: 0 -1rem;
    background: var(--surface);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    pointer-events: none;
  }
  .step__summary:hover::before { opacity: 1; }
  .step__summary > * { position: relative; }

  .step__summary:hover .step__icon { color: var(--fg); }

  .step__index {
    flex: none;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--fg);
  }

  /* 18px on the original, whatever the window width. */
  .step__title {
    flex: 1;
    font-size: 1.125rem;
    font-weight: 400;
  }

  .step__icon {
    position: relative;
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--fg-muted);
  }
  .step__icon::before,
  .step__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.4px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .step__icon::after { transform: rotate(90deg); }
  .step.is-open .step__icon::after { transform: rotate(0deg); }

  /* `grid-template-rows: 0fr -> 1fr` tweens to the content's own height with
     no measuring, which a paused compositor cannot get wrong. */
  .step__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--spring-smooth);
  }

  .step.is-open .step__panel { grid-template-rows: 1fr; }

  .step__inner {
    overflow: hidden;
    padding-left: 1.5rem;
    max-width: 68ch;
  }

  .step__inner > p {
    padding-bottom: clamp(1.25rem, 2.5vw, 1.85rem);
    font-size: 0.9375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .step__panel { transition: none; }
  }

  @media (max-width: 809.98px) {
    .step__inner { padding-left: 0; }
  }

  /* --- Showcase slider --------------------------------------------------- */

  .showcase { padding-bottom: var(--section-y); }

  .slider { position: relative; }

  /* 793px tall at desktop widths, the width simply filling the page — the
     original keeps the height fixed, so it grows wider, not taller. */
  .slider__track {
    position: relative;
    height: 793px;
    overflow: hidden;
    background: var(--bg-raised);
  }

  @media (max-width: 1199.98px) {
    .slider__track { height: 62vw; }
  }

  @media (max-width: 809.98px) {
    .slider__track { height: auto; aspect-ratio: 4 / 3; }
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s var(--spring-smooth);
  }

  .slide[data-active] {
    opacity: 1;
    pointer-events: auto;
  }

  /* Each photograph settles from slightly large as its slide comes in. */
  .slide__zoom {
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(1.08);
    transition: transform 1.6s var(--spring-smooth);
  }

  .slide[data-active] .slide__zoom { transform: scale(1); }
  .slide[data-active]:hover .slide__zoom { transform: scale(1.03); }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide__meta {
    position: absolute;
    top: 28px;
    left: 32px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .slide__title {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .slide__services {
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.7);
  }

  .showcase :global(.slider__all) {
    position: absolute;
    top: 30px;
    right: 32px;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .slider__dots {
    position: absolute;
    left: 50%;
    bottom: 73px;
    translate: -50% 0;
    display: flex;
    gap: 8px;
  }

  .slider__dot {
    width: 28px;
    height: 6px;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: background-color 0.4s var(--ease);
  }

  .slider__dot:hover { background: rgba(255, 255, 255, 0.55); }
  .slider__dot[aria-selected='true'] { background: var(--fg); }

  @media (max-width: 809.98px) {
    .slide__meta { top: 16px; left: 16px; }
    .slide__title { font-size: 1rem; }
    .slide__services { font-size: 0.875rem; }
    .showcase :global(.slider__all) { display: none; }
    .slider__dots { bottom: 20px; }
  }

  /* --- Preview switcher (only on /apercu/…) -------------------------------
     Folded into a small pill in the corner, clear of the hero's own caption
     and badge; it opens upwards. */

  .switcher {
    position: fixed;
    z-index: 60;
    right: 12px;
    bottom: 12px;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .switcher__toggle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: rgba(22, 22, 22, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .switcher__toggle::-webkit-details-marker { display: none; }

  .switcher__kicker {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-dim);
  }

  .switcher__toggle svg { transition: transform 0.35s var(--ease); }
  .switcher:not([open]) .switcher__toggle svg { transform: rotate(180deg); }

  .switcher__list {
    position: absolute;
    right: 0;
    bottom: calc(100% + 8px);
    min-width: 240px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border: 1px solid var(--line-soft);
    border-radius: 14px;
    background: rgba(22, 22, 22, 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    animation: switcher-in 0.35s var(--spring-smooth);
  }

  @keyframes switcher-in {
    from { opacity: 0; transform: translateY(6px); }
  }

  .switcher__item {
    display: block;
    padding: 0.6rem 0.8rem;
    border-radius: 9px;
    white-space: nowrap;
    color: var(--fg-muted);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .switcher__item:hover { color: var(--fg); background: var(--surface); }
  .switcher__item[aria-current='page'] { color: var(--bg); background: var(--fg); }
  .switcher__item--all { margin-top: 4px; border-top: 1px solid var(--line-soft); border-radius: 0 0 9px 9px; }
</style>

<script>
  /* Module-level handles, so document- and window-level listeners are bound
     once and never pile up across client-side navigations. */
  let sliderTimer = 0;
  let current: { play: () => void; stop: () => void } = { play: () => {}, stop: () => {} };

  document.addEventListener('astro:before-swap', () => {
    current.stop();
    current = { play: () => {}, stop: () => {} };
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) current.stop();
    else current.play();
  });

  const init = () => {
  /* --- Process accordion --------------------------------------------------
     <details> drops its content the instant `open` goes away, so the element
     is kept open until the closing tween has run. ------------------------- */
  const steps = [...document.querySelectorAll<HTMLDetailsElement>('.step')];
  const CLOSE_MS = 520;
  const closeTimers = new WeakMap<HTMLDetailsElement, number>();

  const openStep = (step: HTMLDetailsElement) => {
    const pending = closeTimers.get(step);
    if (pending) { clearTimeout(pending); closeTimers.delete(step); }
    step.open = true;
    const grow = () => step.classList.add('is-open');
    requestAnimationFrame(() => requestAnimationFrame(grow));
    window.setTimeout(grow, 60);
  };

  const closeStep = (step: HTMLDetailsElement) => {
    step.classList.remove('is-open');
    closeTimers.set(
      step,
      window.setTimeout(() => {
        step.open = false;
        closeTimers.delete(step);
      }, CLOSE_MS)
    );
  };

  steps.forEach((step) => {
    if (step.open) step.classList.add('is-open');
    step.querySelector('.step__summary')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (step.classList.contains('is-open')) {
        closeStep(step);
        return;
      }
      // Exclusive, like the original.
      steps.forEach((other) => other !== step && other.classList.contains('is-open') && closeStep(other));
      openStep(step);
    });
  });

  /* --- Expertises rail: hint, wheel and arrows ------------------------------ */
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
  const hint = document.querySelector<HTMLButtonElement>('[data-rail-hint]');
  const hintLabel = document.querySelector<HTMLElement>('[data-rail-hint-label]');

  if (rail) {
    /** One column plus its gap. */
    const step = () => {
      const item = rail.querySelector<HTMLElement>('.rail__item');
      return item ? item.getBoundingClientRect().width + 60 : rail.clientWidth * 0.8;
    };
    const atEnd = () => Math.ceil(rail.scrollLeft + rail.clientWidth) >= rail.scrollWidth - 2;

    const sync = () => {
      const start = rail.scrollLeft <= 2;
      const end = atEnd();
      prev?.toggleAttribute('hidden', start);
      next?.toggleAttribute('hidden', end);
      // Once the last column is in view, the hint offers the way back.
      hint?.toggleAttribute('data-back', end);
      if (hintLabel) hintLabel.textContent = end ? 'Revenir au début' : 'Faites défiler';
    };

    prev?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    hint?.addEventListener('click', () => {
      if (atEnd()) rail.scrollTo({ left: 0, behavior: 'smooth' });
      else rail.scrollBy({ left: step() * 2, behavior: 'smooth' });
    });

    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    // Fonts and images settle after first paint and change scrollWidth.
    window.addEventListener('load', sync, { once: true });
    sync();

    if (window.matchMedia('(pointer: fine)').matches) {
      rail.addEventListener(
        'wheel',
        (e) => {
          if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
          const start = rail.scrollLeft <= 0;
          // Let the page keep scrolling once the rail reaches either end.
          if ((start && e.deltaY < 0) || (atEnd() && e.deltaY > 0)) return;
          e.preventDefault();
          rail.scrollLeft += e.deltaY;
        },
        { passive: false }
      );
    }
  }

  /* --- Showcase slider ----------------------------------------------------- */
  const slider = document.querySelector<HTMLElement>('[data-slider]');

  if (slider) {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-slider-dot]')];
    const INTERVAL = 3000;
    let index = 0;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.toggleAttribute('data-active', n === index);
        s.setAttribute('aria-hidden', n === index ? 'false' : 'true');
      });
      dots.forEach((d, n) => d.setAttribute('aria-selected', n === index ? 'true' : 'false'));
      // The next slide's photograph is needed within three seconds.
      slides[(index + 1) % slides.length]?.querySelector('img')?.setAttribute('loading', 'eager');
    };

    /* Still advances when motion is reduced — the cross-fade is what gets
       suppressed there, by the global transition override, not the rotation. */
    const play = () => {
      stop();
      if (slides.length > 1) sliderTimer = window.setInterval(() => go(index + 1), INTERVAL);
    };
    const stop = () => {
      if (sliderTimer) clearInterval(sliderTimer);
      sliderTimer = 0;
    };

    dots.forEach((d, n) =>
      d.addEventListener('click', () => {
        go(n);
        play();
      })
    );

    // Don't advance under the reader's cursor.
    slider.addEventListener('pointerenter', stop);
    slider.addEventListener('pointerleave', play);

    current = { play, stop };
    go(0);
    if (!document.hidden) play();
  }
  };

  /* Only via the event: ClientRouter fires `astro:page-load` on the first
     load as well as after each navigation. Calling init() directly too would
     bind every listener twice, and paired handlers would cancel each other. */
  document.addEventListener('astro:page-load', init);
</script>
