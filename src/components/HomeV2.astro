---
/**
 * V2 of the home page, previewed at /apercu/v2 before it replaces the
 * current one. Same palette, type and motion as the rest of the site; what
 * changes is how much room the work gets:
 *
 *   1. the opening animation (chosen in the CMS), whose title fades out as
 *      "Selected projects" — the CMS's choice, in an offset grid, then a
 *      button to all the projects — slides over it;
 *   2. a short statement and the clients, scrolling;
 *   3. expertises and the process laid out flat, no carousel or accordion;
 *   4. a closing call to get in touch.
 */
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Reveal from './Reveal.astro';
import SplitText from './SplitText.astro';
import ArrowLink from './ArrowLink.astro';
import Hero from './hero/Hero.astro';
import { contact, clients, process } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** Marks the page as a preview: not indexed. */
  preview?: boolean;
}
const { preview = false } = Astro.props;

type Project = CollectionEntry<'projects'>;

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byId = new Map(projects.map((p) => [p.id, p]));
const pick = (id: string) => {
  const p = byId.get(id);
  if (!p) throw new Error(`home.md names a project that does not exist: "${id}"`);
  return p;
};

const heroSlides = home.data.hero.slides.length
  ? home.data.hero.slides.map((s) => ({ project: pick(s.project.id), image: s.image }))
  : projects.map((p) => ({ project: p, image: p.data.cover }));

const selected = home.data.selected.map((ref) => pick(ref.id));

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.order - b.data.order);
const expertiseCards = await Promise.all(
  expertises.map(async (e) => ({
    entry: e,
    Content: (await render(e)).Content,
    count: projects.filter((p) => p.data.services.includes(e.data.service)).length,
  }))
);

/** The photograph shown in the mosaic. */
const main = (p: Project): ImageMetadata => p.data.homeImage ?? p.data.cover;

/** A second photograph, shown when the card is hovered. */
const alt = (p: Project): ImageMetadata => {
  const pool = [p.data.cover, p.data.thumb, ...p.data.strip, ...p.data.grid.map((g) => g.src)];
  return pool.find((img) => img.src !== main(p).src) ?? main(p);
};

const pad = (n: number) => String(n).padStart(2, '0');

const statement =
  'Directrice artistique et designer graphique à Bordeaux, je crée des projets visuels sur mesure pour marques et institutions, en privilégiant sens, esthétique et impact.';
---

<Base title={preview ? 'Aperçu — Accueil V2' : undefined} noindex={preview}>
  {/*
    The hero stays pinned while "Selected projects" rises over it on a grey
    panel, as on the V1; the title fades out as it comes.
  */}
  <div class="curtain">
    <Hero variant={home.data.hero.style} slides={heroSlides} />

    {/* ------------------------------------------------- Selected projects */}
    <section class="section selected" id="work">
      <div class="wrap">
        <Reveal class="section-head">
          <SplitText as="h2" text="Selected projects" class="label--section" />
          <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
        </Reveal>

        <div class="mosaic">
          {
            selected.map((p, i) => (
              <Reveal class="mosaic__item r-30" delay={(i % 2) * 0.12}>
                <a class="scard" href={url(`/projects/${p.id}`)}>
                  <span class="swap scard__media">
                    <span class="swap__inner">
                    <Image
                      src={main(p)}
                      alt={p.data.title}
                      widths={[500, 800, 1240, 1800, 2400]}
                      quality={85}
                      sizes="(max-width: 809px) 96vw, 55vw"
                      style={p.data.homeZoom ? `--zoom:${p.data.homeZoom}` : undefined}
                      data-fade
                    />
                    <Image
                      class="swap__alt"
                      src={alt(p)}
                      alt=""
                      widths={[500, 800, 1240, 1800, 2400]}
                      quality={85}
                      sizes="(max-width: 809px) 96vw, 55vw"
                    />
                    </span>
                  </span>
                  <span class="scard__caption">
                    <span class="scard__index">{pad(i + 1)}</span>
                    <span class="scard__text">
                      <span class="scard__title">{p.data.title}</span>
                      <span class="scard__services">{p.data.services.join(' / ')}</span>
                    </span>
                  </span>
                </a>
              </Reveal>
            ))
          }
        </div>

        <Reveal class="more r-20">
          <a class="more__button" href={url('/projects')}>
            <span>Voir tous les projets</span>
            <span class="more__count">({pad(projects.length)})</span>
            <span class="more__disc" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18">
                <path
                  d="M13.922 4.5v7.313a.422.422 0 0 1-.844 0V5.52l-8.283 8.275a.422.422 0 0 1-.59-.59l8.275-8.283H6.187a.422.422 0 0 1 0-.844H13.5c.233 0 .422.189.422.422Z"
                  fill="currentColor"></path>
              </svg>
            </span>
          </a>
        </Reveal>
      </div>
    </section>
  </div>

  {/* -------------------------------------------- Statement + clients */}
  <section class="section studio r-sect" data-reveal>
    <div class="wrap studio__grid">
      <div class="studio__label">
        <SplitText as="p" text="Le studio" class="label--section" />
      </div>
      <div class="studio__body">
        <SplitText
          as="p"
          text={statement}
          preset="body"
          emphasis={['projets visuels sur mesure', 'sens, esthétique et impact']}
          class="studio__statement"
        />
        <Reveal class="studio__facts r-20" delay={0.2}>
          <dl class="facts">
            <div><dt>Projets</dt><dd>{pad(projects.length)}</dd></div>
            <div><dt>Expertises</dt><dd>{pad(expertises.length)}</dd></div>
            <div><dt>Basée à</dt><dd>{contact.city}</dd></div>
          </dl>
          <ArrowLink href={url('/contact')}>Travaillons ensemble</ArrowLink>
        </Reveal>
      </div>
    </div>

    <div class="clients" aria-label="Clients">
      <Reveal class="wrap clients__label">
        <SplitText as="p" text="Ils m'ont fait confiance" class="label" />
      </Reveal>
      <Reveal class="marquee r-20" delay={0.1}>
        {
          [0, 1].map((copy) => (
            <ul class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {clients.map((c) => (
                <li class="marquee__item">{c}</li>
              ))}
            </ul>
          ))
        }
      </Reveal>
    </div>
  </section>

  {/* -------------------------------------------------------- Expertises */}
  <section class="section r-sect" id="expertises" data-reveal>
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Expertises" class="label--section" />
      </Reveal>

      <ul class="skills">
        {
          expertiseCards.map(({ entry, Content, count }, i) => (
            <li>
              <Reveal class="r-20" delay={(i % 4) * 0.06}>
                <a class="skill" href={url(`/projects/expertises/${entry.id}`)}>
                  <span class="skill__top">
                    <span class="skill__index">{entry.data.index}</span>
                    <span class="skill__count">
                      {count} projet{count > 1 ? 's' : ''}
                    </span>
                  </span>
                  <span class="skill__title">{entry.data.title}</span>
                  <span class="skill__body">
                    <Content />
                  </span>
                  <span class="skill__go" aria-hidden="true">
                    <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                      <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                  </span>
                </a>
              </Reveal>
            </li>
          ))
        }
        {/* Seven expertises leave one cell in the four-column grid. */}
        <li class="skills__extra">
          <Reveal class="r-20" delay={0.18}>
            <a class="skill skill--contact" href={url('/contact')}>
              <span class="skill__top"><span>Sur mesure</span></span>
              <span class="skill__title">Un besoin spécifique ?</span>
              <span class="skill__body">
                Chaque projet est différent. Racontez-moi le vôtre, on construit la réponse ensemble.
              </span>
              <span class="skill__go" aria-hidden="true">
                <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                  <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
            </a>
          </Reveal>
        </li>
      </ul>
    </div>
  </section>

  {/* ----------------------------------------------------------- Process */}
  <section class="section r-sect" id="process" data-reveal>
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Comment se déroule un projet ?" class="label--section" />
      </Reveal>

      <ol class="steps">
        {
          process.map((step, i) => (
            <li>
              <Reveal class="step r-30" delay={(i % 3) * 0.08}>
                <span class="step__num">{pad(i + 1)}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__body">{step.body}</p>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------------------- CTA */}
  <section class="section cta">
    <div class="wrap">
      <Reveal>
        <p class="label cta__kicker">Un projet en tête ?</p>
      </Reveal>
      <a class="cta__link" href={url('/contact')}>
        <SplitText text="Parlons-en" preset="heading" class="display cta__word" />
        <span class="cta__disc" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18">
            <path
              d="M13.922 4.5v7.313a.422.422 0 0 1-.844 0V5.52l-8.283 8.275a.422.422 0 0 1-.59-.59l8.275-8.283H6.187a.422.422 0 0 1 0-.844H13.5c.233 0 .422.189.422.422Z"
              fill="currentColor"></path>
          </svg>
        </span>
      </a>
      <Reveal class="cta__direct r-20" delay={0.3}>
        <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
        <a class="link" href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  /* --- Curtain ------------------------------------------------------------
     The hero is pinned (sticky, in Hero.astro) and publishes its scroll
     progress as --hp, 0 -> 1 over the first screen. "Selected projects"
     rises over it on its grey panel, as on the V1, while the title and the
     photographs of the opening fade out. */

  .curtain { position: relative; }

  /* The grey panel that rises over the pinned hero, as on the V1. */
  .selected {
    position: relative;
    z-index: 1;
    padding-top: var(--section-y);
    background: var(--bg-panel);
  }

  /* The whole opening screen — title and the photographs around it —
     fades out together, gone by the time the projects reach the middle. */
  .curtain :global(.hero__stage) {
    opacity: clamp(0, calc(1 - var(--hp, 0) * 1.4), 1);
  }

  .curtain :global(.hero__inner) {
    transform: translateY(calc(var(--hp, 0) * -6vh));
  }

  .curtain :global(.badge) { opacity: clamp(0, calc(1 - var(--hp, 0) * 3), 1); }

  .count {
    margin-left: 0.5em;
    white-space: nowrap;
    color: var(--fg-dim);
  }

  /* --- Image swap on hover ------------------------------------------------ */

  .swap {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-raised);
  }

  /* Each photograph settles in its frame as its card comes into view —
     the same gesture as the V1 slideshow's slides (1.08 -> 1). */
  .swap__inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(1.08);
    transition: transform 1.6s var(--spring-smooth) calc(0.2s + var(--reveal-delay, 0s));
  }

  :global(.is-visible) > .scard .swap__inner,
  :global(html.no-js) .swap__inner { transform: none; }

  .swap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--spring-smooth);
  }

  /* The second photograph wipes up from below rather than fading, so the
     change reads as deliberate. */
  .swap :global(.swap__alt) {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0);
    transform: scale(1.06);
    transition:
      clip-path 0.9s var(--spring-smooth),
      transform 1.2s var(--spring-smooth);
  }

  a:hover .swap :global(.swap__alt),
  a:focus-visible .swap :global(.swap__alt) {
    clip-path: inset(0 0 0 0);
    transform: none;
  }

  a:hover .swap :global(img:not(.swap__alt)) { transform: scale(1.04); }

  /* A per-project zoom (homeZoom), on its own property so it stacks with
     the hover and fade-in transforms instead of being replaced by them. */
  .swap :global(img:not(.swap__alt)) { scale: var(--zoom, 1); }

  /* --- Studio statement --------------------------------------------------- */

  .studio { padding-top: clamp(4rem, 9vw, 8rem); }

  .studio__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .studio :global(.studio__label) { grid-column: 1 / span 3; }

  .studio__body { grid-column: 4 / -1; }

  .studio :global(.studio__statement) {
    font-size: clamp(1.5rem, 2.9vw, 2.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--fg-muted);
  }

  .studio :global(.studio__facts) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .facts {
    display: flex;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin: 0;
  }

  .facts dt {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .facts dd {
    margin: 0.35rem 0 0;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* --- Clients marquee ---------------------------------------------------- */

  .clients { margin-top: clamp(4rem, 8vw, 7rem); }

  .clients :global(.clients__label) { display: block; margin-bottom: 1.5rem; }

  .marquee {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--line-soft);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__group {
    display: flex;
    flex: none;
    animation: marquee 38s linear infinite;
  }

  .marquee:hover .marquee__group { animation-play-state: paused; }

  .marquee__item {
    display: flex;
    align-items: center;
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.28);
    transition: color 0.4s var(--ease);
  }

  .marquee__item:hover { color: var(--fg); }

  .marquee__item::after {
    content: '';
    width: 0.18em;
    height: 0.18em;
    margin-inline: 0.6em;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
  }

  @keyframes marquee {
    to { transform: translateX(-100%); }
  }

  /* --- Selected projects: offset mosaic ---------------------------------- */

  /* Two rows that answer each other:

       1  large 3:2, left, high   2  narrow 4:5, right, low
       3  medium 3:2, left, high  4  large 5:4, right, low                   */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(2.5rem, 4.5vw, 4rem);
    align-items: start;
  }

  .mosaic :global(.mosaic__item) {
    grid-column: var(--col);
    margin-top: var(--drop, 0);
  }

  .mosaic :global(.mosaic__item:nth-child(4n + 1)) { --col: 1 / span 7; --ratio: 3 / 2; }
  .mosaic :global(.mosaic__item:nth-child(4n + 2)) { --col: 9 / span 4; --ratio: 4 / 5; --drop: clamp(3rem, 9vw, 8rem); }
  .mosaic :global(.mosaic__item:nth-child(4n + 3)) { --col: 1 / span 5; --ratio: 3 / 2; }
  .mosaic :global(.mosaic__item:nth-child(4n))     { --col: 7 / span 6; --ratio: 5 / 4; --drop: clamp(3rem, 9vw, 8rem); }

  .scard { display: block; }

  .scard__media { aspect-ratio: var(--ratio, 4 / 3); }

  .scard__caption {
    display: flex;
    gap: 1.25rem;
    margin-top: 20px;
  }

  .scard__index {
    flex: none;
    padding-top: 0.2em;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--fg-dim);
  }

  .scard__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .scard__title {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .scard__services {
    font-size: 0.875rem;
    color: var(--fg-dim);
  }

  /* --- "Voir tous les projets" ----------------------------------------- */

  .selected :global(.more) {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .more__button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.55rem 0.55rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .more__count { color: var(--fg-dim); transition: color 0.4s var(--ease); }

  .more__disc {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease);
  }

  .more__disc svg { transition: transform 0.5s var(--spring-smooth); }

  .more__button:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .more__button:hover .more__count { color: rgba(22, 22, 22, 0.55); }
  .more__button:hover .more__disc { background: var(--bg); color: var(--fg); }
  .more__button:hover .more__disc svg { transform: translate(2px, -2px); }

  /* --- Expertises: flat grid --------------------------------------------- */

  .skills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-soft);
    border-left: 1px solid var(--line-soft);
  }

  .skills > li {
    border-right: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .skills :global([data-reveal]) { height: 100%; }

  .skill {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 320px;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    transition: background-color 0.4s var(--ease);
  }

  .skill:hover { background: var(--surface); }

  .skill__top {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .skill__title {
    margin-top: 2.25rem;
    font-size: clamp(1.25rem, 1.7vw, 1.625rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .skill__body {
    display: block;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .skill__body :global(p) { margin: 0; }

  .skill__go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-top: auto;
    border-radius: 50%;
    background: var(--surface);
    color: var(--fg-muted);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
  }

  .skill:hover .skill__go { background: var(--fg); color: var(--bg); }

  .skill--contact { background: var(--surface); }
  .skill--contact:hover { background: var(--surface-hover); }
  .skill--contact .skill__go { background: var(--fg); color: var(--bg); }

  /* In two columns, seven plus this one fill four full rows; in one column
     it would only repeat the closing call. */

  /* --- Process: six steps, laid flat ------------------------------------- */

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(2.5rem, 5vw, 4rem);
  }

  .steps :global(.step) {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .step__num {
    display: block;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.22);
  }

  .step__title {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .step__body {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--fg-muted);
  }

  /* --- Closing call ------------------------------------------------------- */

  .cta {
    padding-block: clamp(5rem, 12vw, 10rem) clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  .cta__kicker { margin-bottom: 1.25rem; }

  .cta__link {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  .cta :global(.cta__word) {
