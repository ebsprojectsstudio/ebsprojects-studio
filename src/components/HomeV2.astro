  /* A repeating pattern of four: wide, tall and dropped, tall, wide and
     dropped — so the eye zigzags down the page instead of scanning a grid. */
  .mosaic :global(.mosaic__item:nth-child(4n + 1)) { grid-column: 1 / span 7; }
  .mosaic :global(.mosaic__item:nth-child(4n + 2)) { grid-column: 9 / span 4; margin-top: clamp(4rem, 14vw, 13rem); }
  .mosaic :global(.mosaic__item:nth-child(4n + 3)) { grid-column: 2 / span 4; }
  .mosaic :global(.mosaic__item:nth-child(4n)) { grid-column: 6 / span 7; margin-top: clamp(3rem, 9vw, 8rem); }

  .scard { display: block; }

  .mosaic :global(.mosaic__item:nth-child(4n + 1)) .scard__media,
  .mosaic :global(.mosaic__item:nth-child(4n)) .scard__media { aspect-ratio: 4 / 3; }

