---
/**
 * V2 of the home page, previewed at /apercu/v2 before it replaces the
 * current one. Same palette, type and motion as the rest of the site; what
 * changes is how much room the work gets:
 *
 *   1. the opening animation (chosen in the CMS), whose title fades out as
 *      "Selected projects" — every project, in an offset grid — slides over it;
 *   2. a short statement and the clients, scrolling;
 *   3. every project as an index, the photograph following the cursor;
 *   4. expertises and the process laid out flat, no carousel or accordion;
 *   5. a closing call to get in touch.
 */
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Reveal from './Reveal.astro';
import SplitText from './SplitText.astro';
import ArrowLink from './ArrowLink.astro';
import Hero from './hero/Hero.astro';
import { contact, clients, process } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** Marks the page as a preview: not indexed. */
  preview?: boolean;
}
const { preview = false } = Astro.props;

type Project = CollectionEntry<'projects'>;

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byId = new Map(projects.map((p) => [p.id, p]));
const pick = (id: string) => {
  const p = byId.get(id);
  if (!p) throw new Error(`home.md names a project that does not exist: "${id}"`);
  return p;
};

const heroSlides = home.data.hero.slides.length
  ? home.data.hero.slides.map((s) => ({ project: pick(s.project.id), image: s.image }))
  : projects.map((p) => ({ project: p, image: p.data.cover }));

/* Every project goes in the mosaic: the ones chosen as "Selected projects"
   first, in their CMS order, then the rest in the order of the projects page. */
const chosen = home.data.selected.map((ref) => pick(ref.id));
const selected = [...chosen, ...projects.filter((p) => !chosen.includes(p))];

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.order - b.data.order);
const expertiseCards = await Promise.all(
  expertises.map(async (e) => ({
    entry: e,
    Content: (await render(e)).Content,
    count: projects.filter((p) => p.data.services.includes(e.data.service)).length,
  }))
);

/** A second photograph, shown when the card is hovered. */
const alt = (p: Project): ImageMetadata => {
  const pool = [p.data.thumb, ...p.data.strip, ...p.data.grid.map((g) => g.src)];
  return pool.find((img) => img.src !== p.data.cover.src) ?? p.data.cover;
};

const pad = (n: number) => String(n).padStart(2, '0');

const statement =
  'Directrice artistique et designer graphique à Bordeaux, je crée des projets visuels sur mesure pour marques et institutions, en privilégiant sens, esthétique et impact.';
---

<Base title={preview ? 'Aperçu — Accueil V2' : undefined} noindex={preview}>
  {/*
    The hero stays pinned while "Selected projects" rises over it. The
    section is see-through, so the photographs pass over the title, which
    fades out as they come.
  */}
  <div class="curtain">
    <Hero variant={home.data.hero.style} slides={heroSlides} />

    {/* ------------------------------------------------- Selected projects */}
    <section class="section selected" id="work">
      <div class="wrap">
        <Reveal class="section-head">
          <SplitText as="h2" text="Selected projects" class="label--section" />
          <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
        </Reveal>

        <div class="mosaic">
          {
            selected.map((p, i) => (
              <Reveal class="mosaic__item">
                <a class="scard" href={url(`/projects/${p.id}`)}>
                  <span class="swap scard__media">
                    <Image
                      src={p.data.cover}
                      alt={p.data.title}
                      widths={[500, 800, 1240, 1800, 2400]}
                      quality={85}
                      sizes="(max-width: 809px) 96vw, 55vw"
                      data-fade
                    />
                    <Image
                      class="swap__alt"
                      src={alt(p)}
                      alt=""
                      widths={[500, 800, 1240, 1800, 2400]}
                      quality={85}
                      sizes="(max-width: 809px) 96vw, 55vw"
                    />
                  </span>
                  <span class="scard__caption">
                    <span class="scard__index">{pad(i + 1)}</span>
                    <span class="scard__text">
                      <span class="scard__title">{p.data.title}</span>
                      <span class="scard__services">{p.data.services.join(' / ')}</span>
                    </span>
                  </span>
                </a>
              </Reveal>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {/* -------------------------------------------- Statement + clients */}
  <section class="section studio">
    <div class="wrap studio__grid">
      <Reveal class="studio__label">
        <p class="label--section">Le studio</p>
      </Reveal>
      <div class="studio__body">
        <SplitText
          as="p"
          text={statement}
          preset="body"
          emphasis={['projets visuels sur mesure', 'sens, esthétique et impact']}
          class="studio__statement"
        />
        <Reveal class="studio__facts">
          <dl class="facts">
            <div><dt>Projets</dt><dd>{pad(projects.length)}</dd></div>
            <div><dt>Expertises</dt><dd>{pad(expertises.length)}</dd></div>
            <div><dt>Basée à</dt><dd>{contact.city}</dd></div>
          </dl>
          <ArrowLink href={url('/contact')}>Travaillons ensemble</ArrowLink>
        </Reveal>
      </div>
    </div>

    <div class="clients" aria-label="Clients">
      <p class="wrap label clients__label">Ils m'ont fait confiance</p>
      <div class="marquee">
        {
          [0, 1].map((copy) => (
            <ul class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {clients.map((c) => (
                <li class="marquee__item">{c}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------- Project index */}
  <section class="section index-section">
    <div class="wrap">
      <Reveal class="section-head">
        <h2 class="label--section">
          <SplitText text="Tous les projets" />
          <span class="count">({pad(projects.length)})</span>
        </h2>
      </Reveal>

      <ol class="index" data-index>
        {
          projects.map((p, i) => (
            <li>
              <Reveal class="r-20">
                <a class="row" href={url(`/projects/${p.id}`)} data-index-row={i}>
                  <span class="row__num">{pad(i + 1)}</span>
                  <span class="row__title">
                    {p.data.title}
                  </span>
                  <span class="row__services">{p.data.services.join(', ')}</span>
                  <span class="row__go" aria-hidden="true">
                    <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                      <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                  </span>
                </a>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>

    {/* Follows the cursor over the list; pointer devices only. */}
    <div class="peek" data-peek aria-hidden="true">
      {
        projects.map((p, i) => (
          <Image
            src={p.data.cover}
            alt=""
            widths={[500, 800]}
            quality={80}
            sizes="340px"
            data-peek-img={i}
          />
        ))
      }
    </div>
  </section>

  {/* -------------------------------------------------------- Expertises */}
  <section class="section" id="expertises">
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Expertises" class="label--section" />
      </Reveal>

      <ul class="skills">
        {
          expertiseCards.map(({ entry, Content, count }, i) => (
            <li>
              <Reveal class="r-20" delay={(i % 4) * 0.06}>
                <a class="skill" href={url(`/projects/expertises/${entry.id}`)}>
                  <span class="skill__top">
                    <span class="skill__index">{entry.data.index}</span>
                    <span class="skill__count">
                      {count} projet{count > 1 ? 's' : ''}
                    </span>
                  </span>
                  <span class="skill__title">{entry.data.title}</span>
                  <span class="skill__body">
                    <Content />
                  </span>
                  <span class="skill__go" aria-hidden="true">
                    <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                      <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                  </span>
                </a>
              </Reveal>
            </li>
          ))
        }
        {/* Seven expertises leave one cell in the four-column grid. */}
        <li class="skills__extra">
          <Reveal class="r-20" delay={0.18}>
            <a class="skill skill--contact" href={url('/contact')}>
              <span class="skill__top"><span>Sur mesure</span></span>
              <span class="skill__title">Un besoin spécifique ?</span>
              <span class="skill__body">
                Chaque projet est différent. Racontez-moi le vôtre, on construit la réponse ensemble.
              </span>
              <span class="skill__go" aria-hidden="true">
                <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                  <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
            </a>
          </Reveal>
        </li>
      </ul>
    </div>
  </section>

  {/* ----------------------------------------------------------- Process */}
  <section class="section" id="process">
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Comment se déroule un projet ?" class="label--section" />
      </Reveal>

      <ol class="steps">
        {
          process.map((step, i) => (
            <li>
              <Reveal class="step r-30" delay={(i % 3) * 0.08}>
                <span class="step__num">{pad(i + 1)}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__body">{step.body}</p>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------------------- CTA */}
  <section class="section cta">
    <div class="wrap">
      <Reveal>
        <p class="label cta__kicker">Un projet en tête ?</p>
      </Reveal>
      <a class="cta__link" href={url('/contact')}>
        <SplitText text="Parlons-en" preset="heading" class="display cta__word" />
        <span class="cta__disc" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18">
            <path
              d="M13.922 4.5v7.313a.422.422 0 0 1-.844 0V5.52l-8.283 8.275a.422.422 0 0 1-.59-.59l8.275-8.283H6.187a.422.422 0 0 1 0-.844H13.5c.233 0 .422.189.422.422Z"
              fill="currentColor"></path>
          </svg>
        </span>
      </a>
      <Reveal class="cta__direct">
        <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
        <a class="link" href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  /* --- Curtain ------------------------------------------------------------
     The hero is pinned (sticky, in Hero.astro) and publishes its scroll
     progress as --hp, 0 -> 1 over the first screen. "Selected projects"
     has no background of its own, so its photographs slide over the title;
     the title and the photographs of the opening fade out as they cross. */

  .curtain { position: relative; }

  .selected {
    position: relative;
    z-index: 1;
    padding-top: var(--section-y);
  }

  /* The whole opening screen — title and the photographs around it —
     fades out together, gone by the time the projects reach the middle. */
  .curtain :global(.hero__stage) {
    opacity: clamp(0, calc(1 - var(--hp, 0) * 1.4), 1);
  }

  .curtain :global(.hero__inner) {
    transform: translateY(calc(var(--hp, 0) * -6vh));
  }

  .curtain :global(.badge) { opacity: clamp(0, calc(1 - var(--hp, 0) * 3), 1); }

  .count {
    margin-left: 0.5em;
    white-space: nowrap;
    color: var(--fg-dim);
  }

  /* --- Image swap on hover ------------------------------------------------ */

  .swap {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .swap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--spring-smooth);
  }

  /* The second photograph wipes up from below rather than fading, so the
     change reads as deliberate. */
  .swap :global(.swap__alt) {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0);
    transform: scale(1.06);
    transition:
      clip-path 0.9s var(--spring-smooth),
      transform 1.2s var(--spring-smooth);
  }

  a:hover .swap :global(.swap__alt),
  a:focus-visible .swap :global(.swap__alt) {
    clip-path: inset(0 0 0 0);
    transform: none;
  }

  a:hover .swap :global(img:not(.swap__alt)) { transform: scale(1.04); }

  /* --- Studio statement --------------------------------------------------- */

  .studio { padding-top: clamp(4rem, 9vw, 8rem); }

  .studio__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .studio :global(.studio__label) { grid-column: 1 / span 3; }

  .studio__body { grid-column: 4 / -1; }

  .studio :global(.studio__statement) {
    font-size: clamp(1.5rem, 2.9vw, 2.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--fg-muted);
  }

  .studio :global(.studio__facts) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .facts {
    display: flex;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin: 0;
  }

  .facts dt {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .facts dd {
    margin: 0.35rem 0 0;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* --- Clients marquee ---------------------------------------------------- */

  .clients { margin-top: clamp(4rem, 8vw, 7rem); }

  .clients__label { margin-bottom: 1.5rem; }

  .marquee {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--line-soft);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__group {
    display: flex;
    flex: none;
    animation: marquee 38s linear infinite;
  }

  .marquee:hover .marquee__group { animation-play-state: paused; }

  .marquee__item {
    display: flex;
    align-items: center;
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.28);
    transition: color 0.4s var(--ease);
  }

  .marquee__item:hover { color: var(--fg); }

  .marquee__item::after {
    content: '';
    width: 0.18em;
    height: 0.18em;
    margin-inline: 0.6em;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
  }

  @keyframes marquee {
    to { transform: translateX(-100%); }
  }

  /* --- Selected projects: offset mosaic ---------------------------------- */

  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }

  /* A sequence of eight placements, so every project gets its own format
     while the page keeps one rhythm: the same 12 columns, the same gaps,
     the same captions. Each slot sets its columns, its crop and how far it
     drops below the top of its row.

       1  wide, left              2  tall, right, dropped
       3  wide and low, set off-centre
       4  tall, left, dropped     5  wide, right (the first row, mirrored)
       6  square, left            7  landscape, right, slightly dropped
       8  landscape, centred                                                */
  .mosaic :global(.mosaic__item) {
    grid-column: var(--col);
    margin-top: var(--drop, 0);
  }

  .mosaic :global(.mosaic__item:nth-child(8n + 1)) { --col: 1 / span 7;  --ratio: 4 / 3; }
  .mosaic :global(.mosaic__item:nth-child(8n + 2)) { --col: 9 / span 4;  --ratio: 4 / 5; --drop: clamp(4rem, 14vw, 13rem); }
  .mosaic :global(.mosaic__item:nth-child(8n + 3)) { --col: 4 / span 7;  --ratio: 2 / 1; }
  .mosaic :global(.mosaic__item:nth-child(8n + 4)) { --col: 1 / span 4;  --ratio: 4 / 5; --drop: clamp(4rem, 14vw, 13rem); }
  .mosaic :global(.mosaic__item:nth-child(8n + 5)) { --col: 6 / span 7;  --ratio: 3 / 2; }
  .mosaic :global(.mosaic__item:nth-child(8n + 6)) { --col: 1 / span 5;  --ratio: 1 / 1; }
  .mosaic :global(.mosaic__item:nth-child(8n + 7)) { --col: 7 / span 6;  --ratio: 3 / 2; --drop: clamp(2rem, 7vw, 6rem); }
  .mosaic :global(.mosaic__item:nth-child(8n))     { --col: 3 / span 8;  --ratio: 16 / 9; }

  .scard { display: block; }

  .scard__media { aspect-ratio: var(--ratio, 4 / 3); }

  .scard__caption {
    display: flex;
    gap: 1.25rem;
    margin-top: 20px;
  }

  .scard__index {
    flex: none;
    padding-top: 0.2em;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--fg-dim);
  }

  .scard__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .scard__title {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .scard__services {
    font-size: 0.875rem;
    color: var(--fg-dim);
  }

  /* --- Project index ------------------------------------------------------ */

  .index-section { padding-top: clamp(5rem, 10vw, 9rem); }

  .index { border-top: 1px solid var(--line-soft); }

  .row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 0.55fr) 2rem;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(1.1rem, 2.2vw, 1.75rem);
    border-bottom: 1px solid var(--line-soft);
    transition: opacity 0.45s var(--ease);
  }

  /* Everything but the row under the cursor steps back. */
  .index:hover .row { opacity: 0.32; }
  .index:hover .row:hover { opacity: 1; }

  .row__num {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--fg-dim);
  }

  .row__title {
    font-size: clamp(1.25rem, 2.7vw, 2.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    transition: transform 0.6s var(--spring-smooth);
  }

  .row:hover .row__title { transform: translateX(0.6rem); }

  .row__services {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .row__go {
    justify-self: end;
    color: var(--fg-muted);
    transition: transform 0.45s var(--ease), color 0.35s var(--ease);
  }

  .row:hover .row__go { color: var(--fg); transform: translateX(4px); }

  .peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: clamp(220px, 22vw, 340px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition: opacity 0.35s var(--ease), scale 0.6s var(--spring-smooth);
  }

  .peek.is-on { opacity: 1; scale: 1; }

  .peek :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .peek :global(img.is-current) { opacity: 1; }

  @media (hover: none), (pointer: coarse) {
    .peek { display: none; }
  }

  /* --- Expertises: flat grid --------------------------------------------- */

  .skills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-soft);
    border-left: 1px solid var(--line-soft);
  }

  .skills > li {
    border-right: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .skills :global([data-reveal]) { height: 100%; }

  .skill {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 320px;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    transition: background-color 0.4s var(--ease);
  }

  .skill:hover { background: var(--surface); }

  .skill__top {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .skill__title {
    margin-top: 2.25rem;
    font-size: clamp(1.25rem, 1.7vw, 1.625rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .skill__body {
    display: block;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .skill__body :global(p) { margin: 0; }

  .skill__go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-top: auto;
    border-radius: 50%;
    background: var(--surface);
    color: var(--fg-muted);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
  }

  .skill:hover .skill__go { background: var(--fg); color: var(--bg); }

  .skill--contact { background: var(--surface); }
  .skill--contact:hover { background: var(--surface-hover); }
  .skill--contact .skill__go { background: var(--fg); color: var(--bg); }

  /* In two columns, seven plus this one fill four full rows; in one column
     it would only repeat the closing call. */

  /* --- Process: six steps, laid flat ------------------------------------- */

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(2.5rem, 5vw, 4rem);
  }

  .steps :global(.step) {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .step__num {
    display: block;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.22);
  }

  .step__title {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .step__body {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--fg-muted);
  }

  /* --- Closing call ------------------------------------------------------- */

  .cta {
    padding-block: clamp(5rem, 12vw, 10rem) clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  .cta__kicker { margin-bottom: 1.25rem; }

  .cta__link {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  .cta :global(.cta__word) {
    display: inline-block;
    transition: letter-spacing 0.8s var(--spring-smooth);
  }

  .cta__link:hover :global(.cta__word) { letter-spacing: -0.045em; }

  .cta__disc {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(48px, 7vw, 104px);
    height: clamp(48px, 7vw, 104px);
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    transition: transform 0.6s var(--spring-smooth);
  }

  .cta__disc svg {
    width: 42%;
    height: 42%;
    transition: transform 0.6s var(--spring-smooth);
  }

  .cta__link:hover .cta__disc { transform: rotate(45deg); }

  .cta :global(.cta__direct) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2.5rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* --- Smaller screens ---------------------------------------------------- */

  @media (max-width: 1199.98px) {
    .skills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .row { grid-template-columns: 3rem minmax(0, 1fr) 2rem; }
    .row__services { display: none; }
  }

  @media (max-width: 809.98px) {
    .studio__grid { grid-template-columns: minmax(0, 1fr); row-gap: 1.25rem; }
    .studio :global(.studio__label),
    .studio__body { grid-column: auto; }

    .facts { gap: 1.5rem; }
    .facts dd { font-size: 1.375rem; }

    /* The "see all" links in section heads would crowd the label; every
       project is listed further down anyway. */
    .section-head :global(.arrow-link) { display: none; }

    /* One column: the formats stay varied, the low one is opened up so
       it is not a sliver, and nothing is dropped. */
    .mosaic { grid-template-columns: minmax(0, 1fr); }
    .mosaic :global(.mosaic__item:nth-child(n)) { --col: auto; --drop: 0; }
    .mosaic :global(.mosaic__item:nth-child(8n + 3)) { --ratio: 3 / 2; }

    .row { grid-template-columns: 2.25rem minmax(0, 1fr) 1.25rem; gap: 0.9rem; }
    .index:hover .row { opacity: 1; }

    .skills { grid-template-columns: minmax(0, 1fr); }
    .skills__extra { display: none; }
    .skill { min-height: 0; }
    .skill__title { margin-top: 1.25rem; }
    .skill__go { margin-top: 1.5rem; }

    .steps { grid-template-columns: minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__group { animation: none; }
    .marquee { overflow-x: auto; }
  }
</style>

<script>
  /* Bound once at module level so client-side navigations never stack
     listeners; each page load re-points them at the current DOM. */
  let frame = 0;
  let teardown: (() => void) | null = null;

  const init = () => {
    teardown?.();
    teardown = null;

    const list = document.querySelector<HTMLElement>('[data-index]');
    const peek = document.querySelector<HTMLElement>('[data-peek]');
    if (!list || !peek || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const imgs = [...peek.querySelectorAll<HTMLImageElement>('[data-peek-img]')];
    let x = 0, y = 0, tx = 0, ty = 0;
    let active = false;

    const place = () => {
      // Eased follow: the picture trails the cursor slightly.
      x += (tx - x) * 0.16;
      y += (ty - y) * 0.16;
      const w = peek.offsetWidth;
      const h = peek.offsetHeight;
      peek.style.transform = `translate3d(${x - w / 2}px, ${y - h / 2}px, 0)`;
      if (active || Math.abs(tx - x) > 0.5 || Math.abs(ty - y) > 0.5) frame = requestAnimationFrame(place);
      else frame = 0;
    };

    const onMove = (e: PointerEvent) => {
      tx = e.clientX + 40;
      ty = e.clientY;
      if (!active) {
        // First entry: start where the cursor is rather than flying in.
        active = true;
        x = tx;
        y = ty;
        peek.classList.add('is-on');
      }
      if (!frame) frame = requestAnimationFrame(place);
    };

    const onOver = (e: Event) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('[data-index-row]');
      if (!row) return;
      const n = row.dataset.indexRow;
      imgs.forEach((img) => img.classList.toggle('is-current', img.dataset.peekImg === n));
    };

    const onLeave = () => {
      active = false;
      peek.classList.remove('is-on');
    };

    list.addEventListener('pointermove', onMove);
    list.addEventListener('pointerover', onOver);
    list.addEventListener('pointerleave', onLeave);

    teardown = () => {
      list.removeEventListener('pointermove', onMove);
      list.removeEventListener('pointerover', onOver);
      list.removeEventListener('pointerleave', onLeave);
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };
  };

  document.addEventListener('astro:page-load', init);
</script>
