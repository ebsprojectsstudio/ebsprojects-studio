---
/**
 * V2 of the home page, previewed at /apercu/v2 before it replaces the
 * current one. Same palette, type and motion as the rest of the site; what
 * changes is how much room the work gets:
 *
 *   1. the opening animation, unchanged (chosen in the CMS);
 *   2. "Nouveaux projets" — the latest one full width, the others beside it;
 *   3. a short statement and the clients, scrolling;
 *   4. "Selected projects" as an offset editorial grid;
 *   5. every project as an index, the photograph following the cursor;
 *   6. expertises and the process laid out flat, no carousel or accordion;
 *   7. a closing call to get in touch.
 */
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Reveal from './Reveal.astro';
import SplitText from './SplitText.astro';
import ArrowLink from './ArrowLink.astro';
import Hero from './hero/Hero.astro';
import { contact, clients, process } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** Marks the page as a preview: not indexed. */
  preview?: boolean;
}
const { preview = false } = Astro.props;

type Project = CollectionEntry<'projects'>;

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byId = new Map(projects.map((p) => [p.id, p]));
const pick = (id: string) => {
  const p = byId.get(id);
  if (!p) throw new Error(`home.md names a project that does not exist: "${id}"`);
  return p;
};

const heroSlides = home.data.hero.slides.length
  ? home.data.hero.slides.map((s) => ({ project: pick(s.project.id), image: s.image }))
  : projects.map((p) => ({ project: p, image: p.data.cover }));

const latest = home.data.nouveautes.map((ref) => pick(ref.id));
const [featured, ...recent] = latest;
const selected = home.data.selected.map((ref) => pick(ref.id));
const isNew = new Set(latest.map((p) => p.id));

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.order - b.data.order);
const expertiseCards = await Promise.all(
  expertises.map(async (e) => ({
    entry: e,
    Content: (await render(e)).Content,
    count: projects.filter((p) => p.data.services.includes(e.data.service)).length,
  }))
);

/** A second photograph, shown when the card is hovered. */
const alt = (p: Project): ImageMetadata => {
  const pool = [p.data.thumb, ...p.data.strip, ...p.data.grid.map((g) => g.src)];
  return pool.find((img) => img.src !== p.data.cover.src) ?? p.data.cover;
};

/** The first sentence of the project text, for the cards that have room. */
const teaser = (p: Project) => {
  const text = (p.body ?? '').replace(/\s+/g, ' ').trim();
  const first = text.split(/(?<=[.!?])\s/)[0] ?? '';
  return first.length > 170 ? first.slice(0, 167).replace(/\s+\S*$/, '') + '…' : first;
};

const pad = (n: number) => String(n).padStart(2, '0');

const statement =
  'Directrice artistique et designer graphique à Bordeaux, je crée des projets visuels sur mesure pour marques et institutions, en privilégiant sens, esthétique et impact.';
---

<Base title={preview ? 'Aperçu — Accueil V2' : undefined} noindex={preview}>
  <div class="curtain">
    <Hero variant={home.data.hero.style} slides={heroSlides} />

    <div class="panel">
      {/* ------------------------------------------------- Nouveaux projets */}
      {
        featured && (
          <section class="section latest" id="work">
            <div class="wrap">
              <Reveal class="section-head">
                <h2 class="label--section">
                  <SplitText text="Nouveaux projets" />
                  <span class="count">({pad(latest.length)})</span>
                </h2>
                <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
              </Reveal>

              <Reveal>
                <a class="feat" href={url(`/projects/${featured.id}`)}>
                  <span class="feat__zoom">
                    <Image
                      src={featured.data.cover}
                      alt={featured.data.title}
                      widths={[800, 1280, 1920, 2560, 3200]}
                      quality={85}
                      sizes="(max-width: 809px) 96vw, 90vw"
                      loading="eager"
                      fetchpriority="high"
                      data-fade
                    />
                  </span>
                  <span class="feat__scrim" aria-hidden="true" />
                  <span class="feat__info">
                    <span class="tag">Nouveau</span>
                    <span class="feat__title">{featured.data.title}</span>
                    <span class="feat__meta">
                      {featured.data.client} — {featured.data.services.join(' / ')}
                    </span>
                  </span>
                  <span class="feat__cta">
                    <span>Découvrir le projet</span>
                    <svg width="15" height="11" viewBox="0 0 15 11" fill="none" aria-hidden="true">
                      <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                  </span>
                </a>
              </Reveal>

              {
                recent.length > 0 && (
                  <div class="recent">
                    {recent.map((p, i) => (
                      <Reveal delay={(i % 2) * 0.08}>
                        <a class="ncard" href={url(`/projects/${p.id}`)}>
                          <span class="swap">
                            <Image
                              src={p.data.cover}
                              alt={p.data.title}
                              widths={[500, 800, 1240, 1800]}
                              quality={85}
                              sizes="(max-width: 809px) 96vw, 44vw"
                              data-fade
                            />
                            <Image
                              class="swap__alt"
                              src={alt(p)}
                              alt=""
                              widths={[500, 800, 1240, 1800]}
                              quality={85}
                              sizes="(max-width: 809px) 96vw, 44vw"
                            />
                            <span class="tag tag--on-image">Nouveau</span>
                          </span>
                          <span class="ncard__head">
                            <span class="ncard__title">{p.data.title}</span>
                            <span class="ncard__services">{p.data.services.join(' / ')}</span>
                          </span>
                          {teaser(p) && <span class="ncard__teaser">{teaser(p)}</span>}
                        </a>
                      </Reveal>
                    ))}
                  </div>
                )
              }
            </div>
          </section>
        )
      }

      {/* -------------------------------------------- Statement + clients */}
      <section class="section studio" id={featured ? undefined : 'work'}>
        <div class="wrap studio__grid">
          <Reveal class="studio__label">
            <p class="label--section">Le studio</p>
          </Reveal>
          <div class="studio__body">
            <SplitText
              as="p"
              text={statement}
              preset="body"
              emphasis={['projets visuels sur mesure', 'sens, esthétique et impact']}
              class="studio__statement"
            />
            <Reveal class="studio__facts">
              <dl class="facts">
                <div><dt>Projets</dt><dd>{pad(projects.length)}</dd></div>
                <div><dt>Expertises</dt><dd>{pad(expertises.length)}</dd></div>
                <div><dt>Basée à</dt><dd>{contact.city}</dd></div>
              </dl>
              <ArrowLink href={url('/contact')}>Travaillons ensemble</ArrowLink>
            </Reveal>
          </div>
        </div>

        <div class="clients" aria-label="Clients">
          <p class="wrap label clients__label">Ils m'ont fait confiance</p>
          <div class="marquee">
            {
              [0, 1].map((copy) => (
                <ul class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {clients.map((c) => (
                    <li class="marquee__item">{c}</li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </div>

  {/* ------------------------------------------------- Selected projects */}
  <section class="section selected">
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Selected projects" class="label--section" />
        <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
      </Reveal>

      <div class="mosaic">
        {
          selected.map((p, i) => (
            <Reveal class="mosaic__item">
              <a class="scard" href={url(`/projects/${p.id}`)}>
                <span class="swap scard__media">
                  <Image
                    src={p.data.cover}
                    alt={p.data.title}
                    widths={[500, 800, 1240, 1800, 2400]}
                    quality={85}
                    sizes="(max-width: 809px) 96vw, 55vw"
                    data-fade
                  />
                  <Image
                    class="swap__alt"
                    src={alt(p)}
                    alt=""
                    widths={[500, 800, 1240, 1800, 2400]}
                    quality={85}
                    sizes="(max-width: 809px) 96vw, 55vw"
                  />
                </span>
                <span class="scard__caption">
                  <span class="scard__index">{pad(i + 1)}</span>
                  <span class="scard__text">
                    <span class="scard__title">{p.data.title}</span>
                    <span class="scard__services">{p.data.services.join(' / ')}</span>
                  </span>
                </span>
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------- Project index */}
  <section class="section index-section">
    <div class="wrap">
      <Reveal class="section-head">
        <h2 class="label--section">
          <SplitText text="Tous les projets" />
          <span class="count">({pad(projects.length)})</span>
        </h2>
      </Reveal>

      <ol class="index" data-index>
        {
          projects.map((p, i) => (
            <li>
              <Reveal class="r-20">
                <a class="row" href={url(`/projects/${p.id}`)} data-index-row={i}>
                  <span class="row__num">{pad(i + 1)}</span>
                  <span class="row__title">
                    {p.data.title}
                    {isNew.has(p.id) && <span class="tag tag--inline">Nouveau</span>}
                  </span>
                  <span class="row__services">{p.data.services.join(', ')}</span>
                  <span class="row__go" aria-hidden="true">
                    <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                      <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                  </span>
                </a>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>

    {/* Follows the cursor over the list; pointer devices only. */}
    <div class="peek" data-peek aria-hidden="true">
      {
        projects.map((p, i) => (
          <Image
            src={p.data.cover}
            alt=""
            widths={[500, 800]}
            quality={80}
            sizes="340px"
            data-peek-img={i}
          />
        ))
      }
    </div>
  </section>

  {/* -------------------------------------------------------- Expertises */}
  <section class="section" id="expertises">
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Expertises" class="label--section" />
      </Reveal>

      <ul class="skills">
        {
          expertiseCards.map(({ entry, Content, count }, i) => (
            <li>
              <Reveal class="r-20" delay={(i % 4) * 0.06}>
                <a class="skill" href={url(`/projects/expertises/${entry.id}`)}>
                  <span class="skill__top">
                    <span class="skill__index">{entry.data.index}</span>
                    <span class="skill__count">
                      {count} projet{count > 1 ? 's' : ''}
                    </span>
                  </span>
                  <span class="skill__title">{entry.data.title}</span>
                  <span class="skill__body">
                    <Content />
                  </span>
                  <span class="skill__go" aria-hidden="true">
                    <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                      <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                  </span>
                </a>
              </Reveal>
            </li>
          ))
        }
        {/* Seven expertises leave one cell in the four-column grid. */}
        <li class="skills__extra">
          <Reveal class="r-20" delay={0.18}>
            <a class="skill skill--contact" href={url('/contact')}>
              <span class="skill__top"><span>Sur mesure</span></span>
              <span class="skill__title">Un besoin spécifique ?</span>
              <span class="skill__body">
                Chaque projet est différent. Racontez-moi le vôtre, on construit la réponse ensemble.
              </span>
              <span class="skill__go" aria-hidden="true">
                <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                  <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
            </a>
          </Reveal>
        </li>
      </ul>
    </div>
  </section>

  {/* ----------------------------------------------------------- Process */}
  <section class="section" id="process">
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Comment se déroule un projet ?" class="label--section" />
      </Reveal>

      <ol class="steps">
        {
          process.map((step, i) => (
            <li>
              <Reveal class="step r-30" delay={(i % 3) * 0.08}>
                <span class="step__num">{pad(i + 1)}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__body">{step.body}</p>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------------------- CTA */}
  <section class="section cta">
    <div class="wrap">
      <Reveal>
        <p class="label cta__kicker">Un projet en tête ?</p>
      </Reveal>
      <a class="cta__link" href={url('/contact')}>
        <SplitText text="Parlons-en" preset="heading" class="display cta__word" />
        <span class="cta__disc" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18">
            <path
              d="M13.922 4.5v7.313a.422.422 0 0 1-.844 0V5.52l-8.283 8.275a.422.422 0 0 1-.59-.59l8.275-8.283H6.187a.422.422 0 0 1 0-.844H13.5c.233 0 .422.189.422.422Z"
              fill="currentColor"></path>
          </svg>
        </span>
      </a>
      <Reveal class="cta__direct">
        <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
        <a class="link" href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  /* --- Curtain: as on the current home page ------------------------------ */

  .curtain { position: relative; }

  .panel {
    position: relative;
    z-index: 1;
    background: var(--bg-panel);
  }

  .count {
    margin-left: 0.5em;
    white-space: nowrap;
    color: var(--fg-dim);
  }

  /* --- "Nouveau" tag ------------------------------------------------------ */

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
  }

  .tag::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  .tag--on-image {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
  }

  .tag--inline {
    margin-left: 0.9rem;
    vertical-align: 0.35em;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  /* --- Image swap on hover ------------------------------------------------ */

  .swap {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .swap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--spring-smooth);
  }

  /* The second photograph wipes up from below rather than fading, so the
     change reads as deliberate. */
  .swap :global(.swap__alt) {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0);
    transform: scale(1.06);
    transition:
      clip-path 0.9s var(--spring-smooth),
      transform 1.2s var(--spring-smooth);
  }

  a:hover .swap :global(.swap__alt),
  a:focus-visible .swap :global(.swap__alt) {
    clip-path: inset(0 0 0 0);
    transform: none;
  }

  a:hover .swap :global(img:not(.swap__alt)) { transform: scale(1.04); }

  /* --- Nouveaux projets: featured ---------------------------------------- */

  .feat {
    position: relative;
    display: block;
    height: clamp(440px, 78vh, 860px);
    overflow: hidden;
    background: var(--bg-raised);
  }

  .feat__zoom {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 1.6s var(--spring-smooth);
  }

  .feat__zoom :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feat:hover .feat__zoom { transform: scale(1.035); }

  .feat__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.62) 100%);
    pointer-events: none;
  }

  .feat__info {
    position: absolute;
    left: clamp(1.25rem, 3vw, 2.5rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    bottom: clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .feat__title {
    max-width: 18ch;
    font-size: var(--fs-title);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .feat__meta {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .feat__cta {
    position: absolute;
    top: clamp(1.25rem, 3vw, 2.5rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: rgba(22, 22, 22, 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease);
  }

  .feat__cta svg { transition: transform 0.45s var(--ease); }
  .feat:hover .feat__cta { background: var(--fg); color: var(--bg); }
  .feat:hover .feat__cta svg { transform: translateX(3px); }

  /* --- Nouveaux projets: the others -------------------------------------- */

  .recent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 40px;
  }

  .ncard { display: block; }

  .ncard .swap { aspect-ratio: 613 / 440; }

  .ncard__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-top: 20px;
  }

  .ncard__title {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .ncard__services {
    font-size: 0.875rem;
    color: var(--fg-dim);
  }

  .ncard__teaser {
    display: -webkit-box;
    margin-top: 0.6rem;
    max-width: 60ch;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--fg-muted);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* --- Studio statement --------------------------------------------------- */

  .studio { padding-top: clamp(4rem, 9vw, 8rem); }

  .studio__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .studio :global(.studio__label) { grid-column: 1 / span 3; }

  .studio__body { grid-column: 4 / -1; }

  .studio :global(.studio__statement) {
    font-size: clamp(1.5rem, 2.9vw, 2.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--fg-muted);
  }

  .studio :global(.studio__facts) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .facts {
    display: flex;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin: 0;
  }

  .facts dt {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .facts dd {
    margin: 0.35rem 0 0;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* --- Clients marquee ---------------------------------------------------- */

  .clients { margin-top: clamp(4rem, 8vw, 7rem); }

  .clients__label { margin-bottom: 1.5rem; }

  .marquee {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--line-soft);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__group {
    display: flex;
    flex: none;
    animation: marquee 38s linear infinite;
  }

  .marquee:hover .marquee__group { animation-play-state: paused; }

  .marquee__item {
    display: flex;
    align-items: center;
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.28);
    transition: color 0.4s var(--ease);
  }

  .marquee__item:hover { color: var(--fg); }

  .marquee__item::after {
    content: '';
    width: 0.18em;
    height: 0.18em;
    margin-inline: 0.6em;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
  }

  @keyframes marquee {
    to { transform: translateX(-100%); }
  }

  /* --- Selected projects: offset mosaic ---------------------------------- */

  .selected { padding-top: clamp(5rem, 10vw, 9rem); }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
