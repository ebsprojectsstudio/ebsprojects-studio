<script>
  /* Bound once at module level so client-side navigations never stack
     listeners; each page load re-points them at the current DOM. */
  let frame = 0;
  let teardown: (() => void) | null = null;

  const init = () => {
    teardown?.();
    teardown = null;

    const list = document.querySelector<HTMLElement>('[data-index]');
    const peek = document.querySelector<HTMLElement>('[data-peek]');
    if (!list || !peek || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const imgs = [...peek.querySelectorAll<HTMLImageElement>('[data-peek-img]')];
    let x = 0, y = 0, tx = 0, ty = 0;
    let active = false;

    const place = () => {
      // Eased follow: the picture trails the cursor slightly.
      x += (tx - x) * 0.16;
      y += (ty - y) * 0.16;
      const w = peek.offsetWidth;
      const h = peek.offsetHeight;
      peek.style.transform = `translate3d(${x - w / 2}px, ${y - h / 2}px, 0)`;
      if (active || Math.abs(tx - x) > 0.5 || Math.abs(ty - y) > 0.5) frame = requestAnimationFrame(place);
      else frame = 0;
    };

    const onMove = (e: PointerEvent) => {
      tx = e.clientX + 40;
      ty = e.clientY;
      if (!active) {
        // First entry: start where the cursor is rather than flying in.
        active = true;
        x = tx;
        y = ty;
        peek.classList.add('is-on');
      }
      if (!frame) frame = requestAnimationFrame(place);
    };

    const onOver = (e: Event) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('[data-index-row]');
      if (!row) return;
      const n = row.dataset.indexRow;
      imgs.forEach((img) => img.classList.toggle('is-current', img.dataset.peekImg === n));
    };

    const onLeave = () => {
      active = false;
      peek.classList.remove('is-on');
    };

    list.addEventListener('pointermove', onMove);
    list.addEventListener('pointerover', onOver);
    list.addEventListener('pointerleave', onLeave);

    teardown = () => {
      list.removeEventListener('pointermove', onMove);
      list.removeEventListener('pointerover', onOver);
      list.removeEventListener('pointerleave', onLeave);
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };
  };

  document.addEventListener('astro:page-load', init);
</script>
