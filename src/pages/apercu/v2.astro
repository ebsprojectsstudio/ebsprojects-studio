---
/**
 * The same proposed home page ("V2"), opening on the full-screen slideshow
 * of projects behind the title. Not indexed.
 *
 * Its photographs are chosen here, not in the CMS, so they stay specific to
 * this version — the studio's selection, in its order.
 */
import HomeV2 from '../../components/HomeV2.astro';
import epeda from '../../assets/images/epeda-04.jpg';
import mortSubite from '../../assets/images/mort-subite-04.jpg';
import blackWhitePackaging from '../../assets/images/black-white-burger-cover.jpg';
import blackWhiteWindow from '../../assets/images/black-white-burger-05.jpg';
import adidasProphere from '../../assets/images/adidas-prophere-05.jpg';
import terraDelyssa from '../../assets/images/terra-delyssa-01.jpg';

const slides = [
  { project: 'mort-subite-lambic-botanic', image: mortSubite },
  /* Black & White twice: the packaging, then the shop-window graphics. */
  { project: 'black-white-burger', image: blackWhitePackaging },
  { project: 'black-white-burger', image: blackWhiteWindow },
  { project: 'adidas-collection-prophere', image: adidasProphere },
  { project: 'terra-delyssa', image: terraDelyssa },
  { project: 'epeda-collection-dedicace', image: epeda },
];
---

<HomeV2 variant="plein-ecran" label="V2" slides={slides} preview />
