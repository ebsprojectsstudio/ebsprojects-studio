import adidasPod from '../../assets/images/adidas-pod-02.jpg';
import terraDelyssa from '../../assets/images/terra-delyssa-01.jpg';
import adidasProphere from '../../assets/images/adidas-prophere-05.jpg';

const slides = [
  { project: 'epeda-collection-dedicace', image: epeda },
  { project: 'mort-subite-lambic-botanic', image: mortSubite },
  { project: 'loft-babies-laurent-garnier-goes-disco', image: loftBabies },
  { project: 'black-white-burger', image: blackWhite },
  { project: 'beer-factory', image: beerFactory },
  { project: 'adidas-collection-pod', image: adidasPod },
  { project: 'terra-delyssa', image: terraDelyssa },
