---
/**
 * "Selected projects", three refinements of the studio's own layout (the
 * two-column grid of the original site, cards at 740×476 on a 1680px
 * screen, title below), to choose one for the home page. Not indexed.
 *
 * What all three add to the original:
 *   - each photograph is unveiled from the bottom and settles as it is
 *     scrolled to, the card's caption following just after;
 *   - on hover, a second photograph of the project wipes up over the first,
 *     and a round "Voir" label follows the cursor;
 *   - the caption carries the number and the expertises on one line.
 */
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/Reveal.astro';
import SplitText from '../../components/SplitText.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import { url } from '../../lib/url';

type Project = CollectionEntry<'projects'>;

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');
const all = await getCollection('projects');
const byId = new Map(all.map((p) => [p.id, p]));
const selected = home.data.selected.map((ref) => {
  const p = byId.get(ref.id);
  if (!p) throw new Error(`home.md names a project that does not exist: "${ref.id}"`);
  return p;
});

const main = (p: Project): ImageMetadata => p.data.homeImage ?? p.data.cover;
const second = (p: Project): ImageMetadata => {
  const pool = [p.data.cover, p.data.thumb, ...p.data.strip, ...p.data.grid.map((g) => g.src)];
  return pool.find((img) => img.src !== main(p).src) ?? main(p);
};
const pad = (n: number) => String(n).padStart(2, '0');

const options = [
  { id: 'a', name: 'Ton site, en mieux', desc: 'La même grille de 2 colonnes et les mêmes proportions, avec les nouvelles animations et le survol.' },
  { id: 'b', name: 'Décalée', desc: 'La même grille, la colonne de droite légèrement descendue pour donner du rythme.' },
  { id: 'c', name: 'Large / étroite', desc: 'Deux lignes de même hauteur : grande photo + petite, puis petite + grande.' },
];
---

<Base title="Aperçu — Mises en page des projets" noindex>
  <section class="intro">
    <div class="wrap">
      <p class="label--section">Aperçu</p>
      <h1 class="title intro__title">Selected projects : 3 versions</h1>
      <p class="intro__lead">
        À partir de la grille de ton site, avec en plus : les photos qui se dévoilent au défilement, une deuxième
        photo au survol, et une pastille « Voir » qui suit la souris.
      </p>
      <ol class="intro__list">
        {options.map((o) => (
          <li>
            <a href={`#option-${o.id}`}>
              <span class="intro__letter">{o.id.toUpperCase()}</span>
              <span><strong>{o.name}</strong> — {o.desc}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {
    options.map((o) => (
      <section class={`option option--${o.id}`} id={`option-${o.id}`}>
        <div class="wrap">
          <p class="option__tag">Option {o.id.toUpperCase()} — {o.name}</p>
          <Reveal class="section-head">
            <SplitText as="h2" text="Selected projects" class="label--section" />
            <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
          </Reveal>
          <div class="grid">
            {selected.map((p, i) => (
              <Reveal class="item" delay={(i % 2) * 0.12} data-reveal-at="0.85">
                <a class="card" href={url(`/projects/${p.id}`)} data-peek>
                  <span class="card__media">
                    <span class="card__inner">
                      <Image src={main(p)} alt={p.data.title} widths={[600, 900, 1300, 1800]}
                        sizes="(max-width: 809px) 96vw, 50vw" quality={85}
                        style={p.data.homeZoom ? `--zoom:${p.data.homeZoom}` : undefined} />
                      <Image class="card__alt" src={second(p)} alt="" widths={[600, 900, 1300, 1800]}
                        sizes="(max-width: 809px) 96vw, 50vw" quality={85} />
                    </span>
                  </span>
                  <span class="card__caption">
                    <span class="card__title">
                      <span class="card__index">{pad(i + 1)}</span>
                      {p.data.title}
                    </span>
                    <span class="card__services">{p.data.services.join(', ')}</span>
                  </span>
                </a>
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  {/* Follows the cursor over a card (pointer devices only). */}
  <div class="peek" data-peek-label aria-hidden="true">Voir</div>
</Base>

<style>
  /* --- Page chrome --------------------------------------------------------- */

  .intro { padding: clamp(7rem, 12vw, 9rem) 0 2rem; }
  .intro__title { margin-top: 1rem; font-size: var(--fs-title); }
  .intro__lead { margin-top: 1.25rem; max-width: 62ch; color: var(--fg-muted); }
  .intro__list { margin-top: 1.75rem; display: grid; gap: 0.6rem; max-width: 70ch; }
  .intro__list a { display: flex; gap: 1rem; color: var(--fg-muted); transition: color 0.3s var(--ease); }
  .intro__list a:hover { color: var(--fg); }
  .intro__list strong { color: var(--fg); font-weight: 500; }
  .intro__letter { flex: none; width: 1.6rem; color: var(--fg); }

  .option {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line-soft);
    background: var(--bg-panel);
  }

  .option__tag {
    margin-bottom: 1.5rem;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #dac5a7;
  }

  /* --- The grid: the original's two columns, 40px apart ------------------- */

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 40px;
    row-gap: clamp(3rem, 5vw, 4.5rem);
  }

  /* 740 × 476 on the original at 1680px wide. */
  .card__media { aspect-ratio: 740 / 476; }

  /* B — the right column drops by a quarter of a card. */
  .option--b .grid :global(.item:nth-child(even)) { margin-top: clamp(3rem, 9vw, 9rem); }
  .option--b .grid { padding-bottom: clamp(1rem, 3vw, 3rem); }

  /* C — rows of one height, the wide photograph swapping sides. */
  .option--c .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .option--c .grid :global(.item:nth-child(4n + 1)) { grid-column: span 8; }
  .option--c .grid :global(.item:nth-child(4n + 2)) { grid-column: span 4; }
  .option--c .grid :global(.item:nth-child(4n + 3)) { grid-column: span 4; }
  .option--c .grid :global(.item:nth-child(4n)) { grid-column: span 8; }
  .option--c .card__media { aspect-ratio: auto; height: clamp(300px, 30vw, 500px); }

  /* --- Card ----------------------------------------------------------------- */

  .card { display: block; }

  /* The photograph is unveiled from the bottom as the card is scrolled to,
     and settles from a little large. */
  .card__media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-raised);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.3s var(--spring-smooth) calc(0.15s + var(--reveal-delay, 0s));
  }

  .card__inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(1.15);
    transition: transform 1.8s var(--spring-smooth) calc(0.15s + var(--reveal-delay, 0s));
  }

  :global(.is-visible) > .card .card__media { clip-path: inset(0 0 0 0); }
  :global(.is-visible) > .card .card__inner { transform: none; }

  .card__inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: var(--zoom, 1);
    transition: transform 1.1s var(--spring-smooth);
  }

  /* Hover: the second photograph wipes up over the first. */
  .card__inner :global(.card__alt) {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0);
    transform: scale(1.06);
    transition: clip-path 0.9s var(--spring-smooth), transform 1.2s var(--spring-smooth);
  }
  .card:hover .card__inner :global(.card__alt),
  .card:focus-visible .card__inner :global(.card__alt) { clip-path: inset(0 0 0 0); transform: none; }
  .card:hover .card__inner :global(img:not(.card__alt)) { transform: scale(1.04); }

  /* Caption: number and title on the left, expertises on the right. */
  .card__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    margin-top: 20px;
  }

  .card__title {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .card:hover .card__title { background-size: 100% 1px; }

  .card__index {
    margin-right: 0.9rem;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--fg-dim);
  }

  .card__services {
    flex: none;
    max-width: 50%;
    font-size: 0.875rem;
    text-align: right;
    color: var(--fg-dim);
  }

  /* --- "Voir" label ---------------------------------------------------------- */

  .peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    pointer-events: none;
    opacity: 0;
    scale: 0.4;
    transition: opacity 0.3s var(--ease), scale 0.5s var(--spring-smooth);
  }
  .peek.is-on { opacity: 1; scale: 1; }

  @media (hover: none), (pointer: coarse) {
    .peek { display: none; }
  }

  /* --- Phones and no-motion -------------------------------------------------- */

  @media (max-width: 809.98px) {
    .grid,
    .option--c .grid { grid-template-columns: minmax(0, 1fr); }
    .option--b .grid :global(.item:nth-child(even)) { margin-top: 0; }
    .option--c .grid :global(.item) { grid-column: auto !important; }
    .option--c .card__media { height: auto; aspect-ratio: 740 / 476; }
    .card__caption { flex-direction: column; gap: 0.3rem; }
    .card__services { max-width: none; text-align: left; }
  }

  :global(html.no-js) .card__media { clip-path: none; }
  :global(html.no-js) .card__inner { transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .card__media { clip-path: none; transition: none; }
    .card__inner { transform: none; transition: none; }
  }
</style>

<script>
  let stop: (() => void) | null = null;

  const init = () => {
    stop?.();
    stop = null;
    const label = document.querySelector<HTMLElement>('[data-peek-label]');
    if (!label || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    let x = 0, y = 0, tx = 0, ty = 0, frame = 0, on = false;

    const tick = () => {
      // Eased follow, so the label trails the cursor a touch.
      x += (tx - x) * 0.2;
      y += (ty - y) * 0.2;
      label.style.transform = `translate3d(${x - 42}px, ${y - 42}px, 0)`;
      frame = on || Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
    };

    const move = (e: PointerEvent) => {
      const card = (e.target as HTMLElement).closest('[data-peek]');
      tx = e.clientX;
      ty = e.clientY;
      if (card && !on) {
        on = true;
        x = tx;
        y = ty;
        label.classList.add('is-on');
      } else if (!card && on) {
        on = false;
        label.classList.remove('is-on');
      }
      if (!frame) frame = requestAnimationFrame(tick);
    };

    document.addEventListener('pointermove', move, { passive: true });
    stop = () => {
      document.removeEventListener('pointermove', move);
      if (frame) cancelAnimationFrame(frame);
    };
  };

  document.addEventListener('astro:page-load', init);
</script>
