---
/**
 * Four alternative layouts for "Selected projects", side by side, so the
 * studio can choose one for the home page. Same projects (chosen in the
 * CMS), same type and motion as the rest of the site. Not indexed.
 */
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/Reveal.astro';
import SplitText from '../../components/SplitText.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import { url } from '../../lib/url';

type Project = CollectionEntry<'projects'>;

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');
const all = await getCollection('projects');
const byId = new Map(all.map((p) => [p.id, p]));
const selected = home.data.selected.map((ref) => {
  const p = byId.get(ref.id);
  if (!p) throw new Error(`home.md names a project that does not exist: "${ref.id}"`);
  return p;
});

const main = (p: Project): ImageMetadata => p.data.homeImage ?? p.data.cover;
const pad = (n: number) => String(n).padStart(2, '0');
const teaser = (p: Project) => {
  const text = (p.body ?? '').replace(/\s+/g, ' ').trim();
  const first = text.split(/(?<=[.!?])\s/)[0] ?? '';
  return first.length > 170 ? first.slice(0, 167).replace(/\s+\S*$/, '') + '…' : first;
};

const options = [
  { id: 'a', name: 'Grille', desc: 'Deux colonnes égales, grandes photos, légende dessous. Simple et calme, proche de ton site actuel.' },
  { id: 'b', name: 'Éditorial', desc: "Un projet par ligne : grande photo d'un côté, numéro, titre, phrase et lien de l'autre, en alternant les côtés." },
  { id: 'c', name: 'Défilement', desc: 'Les projets en colonnes verticales qui défilent sur le côté, comme les expertises.' },
  { id: 'd', name: 'Cartes empilées', desc: "Chaque projet en grand, sur toute la largeur ; au défilement, les cartes s'empilent les unes sur les autres." },
];
---

<Base title="Aperçu — Mises en page des projets" noindex>
  <section class="intro">
    <div class="wrap">
      <p class="label--section">Aperçu</p>
      <h1 class="title intro__title">Selected projects : 4 mises en page</h1>
      <ol class="intro__list">
        {options.map((o) => (
          <li>
            <a href={`#option-${o.id}`}>
              <span class="intro__letter">{o.id.toUpperCase()}</span>
              <span><strong>{o.name}</strong> — {o.desc}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="intro__note">L'actuelle (mosaïque décalée) reste visible sur <a class="link" href={url('/')}>l'accueil</a>.</p>
    </div>
  </section>

  {/* ------------------------------------------------------ A · Grille */}
  <section class="option" id="option-a">
    <div class="wrap">
      <p class="option__tag">Option A — {options[0].name}</p>
      <Reveal class="section-head">
        <SplitText as="h2" text="Selected projects" class="label--section" />
        <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
      </Reveal>
      <div class="grid-a">
        {selected.map((p, i) => (
          <Reveal class="r-30" delay={(i % 2) * 0.15} data-reveal-at="0.85">
            <a class="card-a" href={url(`/projects/${p.id}`)}>
              <span class="media media--zoom" style="aspect-ratio: 4 / 3">
                <Image src={main(p)} alt={p.data.title} widths={[600, 900, 1300, 1800]} sizes="(max-width: 809px) 96vw, 45vw" quality={85}
                  style={p.data.homeZoom ? `--zoom:${p.data.homeZoom}` : undefined} data-fade />
              </span>
              <span class="cap">
                <span class="cap__index">{pad(i + 1)}</span>
                <span class="cap__text">
                  <span class="cap__title">{p.data.title}</span>
                  <span class="cap__services">{p.data.services.join(' / ')}</span>
                </span>
              </span>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  {/* --------------------------------------------------- B · Éditorial */}
  <section class="option" id="option-b">
    <div class="wrap">
      <p class="option__tag">Option B — {options[1].name}</p>
      <Reveal class="section-head">
        <SplitText as="h2" text="Selected projects" class="label--section" />
        <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
      </Reveal>
      <div class="rows-b">
        {selected.map((p, i) => (
          <Reveal class:list={['row-b', i % 2 && 'row-b--flip', 'r-30']} data-reveal-at="0.85">
            <a class="row-b__media media media--zoom" href={url(`/projects/${p.id}`)} aria-label={p.data.title}>
              <Image src={main(p)} alt={p.data.title} widths={[700, 1100, 1600, 2200]} sizes="(max-width: 809px) 96vw, 60vw" quality={85}
                style={p.data.homeZoom ? `--zoom:${p.data.homeZoom}` : undefined} data-fade />
            </a>
            <div class="row-b__text">
              <span class="row-b__index">{pad(i + 1)}</span>
              <h3 class="row-b__title">{p.data.title}</h3>
              <p class="row-b__services">{p.data.services.join(' / ')}</p>
              {teaser(p) && <p class="row-b__teaser">{teaser(p)}</p>}
              <ArrowLink href={url(`/projects/${p.id}`)}>Voir le projet</ArrowLink>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  {/* -------------------------------------------------- C · Défilement */}
  <section class="option option--rail" id="option-c">
    <div class="wrap">
      <p class="option__tag">Option C — {options[2].name}</p>
      <Reveal class="section-head">
        <SplitText as="h2" text="Selected projects" class="label--section" />
        <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
      </Reveal>
    </div>
    <ul class="rail-c">
      {selected.map((p, i) => (
        <li>
          <Reveal class="r-30" delay={i * 0.1} data-reveal-at="0.85">
            <a class="card-c" href={url(`/projects/${p.id}`)}>
              <span class="media media--zoom" style="aspect-ratio: 4 / 5">
                <Image src={main(p)} alt={p.data.title} widths={[500, 800, 1200]} sizes="(max-width: 809px) 78vw, 30vw" quality={85}
                  style={p.data.homeZoom ? `--zoom:${p.data.homeZoom}` : undefined} data-fade />
              </span>
              <span class="cap">
                <span class="cap__index">{pad(i + 1)}</span>
                <span class="cap__text">
                  <span class="cap__title">{p.data.title}</span>
                  <span class="cap__services">{p.data.services.join(' / ')}</span>
                </span>
              </span>
            </a>
          </Reveal>
        </li>
      ))}
    </ul>
  </section>

  {/* --------------------------------------------- D · Cartes empilées */}
  <section class="option" id="option-d">
    <div class="wrap">
      <p class="option__tag">Option D — {options[3].name}</p>
      <Reveal class="section-head">
        <SplitText as="h2" text="Selected projects" class="label--section" />
        <ArrowLink href={url('/projects')}>Voir tous les projets</ArrowLink>
      </Reveal>
      <div class="stack-d">
        {selected.map((p, i) => (
          <a class="card-d media--zoom" href={url(`/projects/${p.id}`)} style={`--i:${i}`}>
            <Image src={main(p)} alt={p.data.title} widths={[900, 1400, 2000, 2800]} sizes="(max-width: 809px) 96vw, 90vw" quality={85}
              style={p.data.homeZoom ? `--zoom:${p.data.homeZoom}` : undefined} data-fade />
            <span class="card-d__veil" aria-hidden="true" />
            <span class="card-d__info">
              <span class="card-d__index">{pad(i + 1)} / {pad(selected.length)}</span>
              <span class="card-d__title">{p.data.title}</span>
              <span class="card-d__services">{p.data.services.join(' / ')}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Page chrome --------------------------------------------------------- */

  .intro { padding: clamp(7rem, 12vw, 9rem) 0 2rem; }
  .intro__title { margin-top: 1rem; font-size: var(--fs-title); }
  .intro__list { margin-top: 2rem; display: grid; gap: 0.6rem; max-width: 70ch; }
  .intro__list a { display: flex; gap: 1rem; color: var(--fg-muted); transition: color 0.3s var(--ease); }
  .intro__list a:hover { color: var(--fg); }
  .intro__list strong { color: var(--fg); font-weight: 500; }
  .intro__letter { flex: none; width: 1.6rem; color: var(--fg); }
  .intro__note { margin-top: 1.5rem; color: var(--fg-dim); font-size: 0.875rem; }

  .option {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line-soft);
    background: var(--bg-panel);
  }
  .option:nth-of-type(odd) { background: var(--bg); }

  .option__tag {
    margin-bottom: 1.5rem;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #dac5a7;
  }

  /* --- Shared bits ---------------------------------------------------------- */

  .media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .media :global(img),
  .card-d :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: var(--zoom, 1);
  }
  .media--zoom :global(img) { transition: transform 1.1s var(--spring-smooth); }
  a:hover .media--zoom :global(img),
  .media--zoom:hover :global(img) { transform: scale(1.04); }

  .cap { display: flex; gap: 1.25rem; margin-top: 20px; }
  .cap__index {
    flex: none;
    padding-top: 0.3em;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--fg-dim);
  }
  .cap__text { display: flex; flex-direction: column; gap: 0.3rem; }
  .cap__title { font-size: 1.125rem; line-height: 1.3; letter-spacing: -0.01em; }
  .cap__services { font-size: 0.9375rem; color: var(--fg-dim); }

  /* --- A · Grille ----------------------------------------------------------- */

  .grid-a {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 40px;
    row-gap: clamp(3rem, 5vw, 4.5rem);
  }
  .card-a { display: block; }

  /* --- B · Éditorial -------------------------------------------------------- */

  .rows-b { display: grid; gap: clamp(4rem, 8vw, 7rem); }

  .rows-b :global(.row-b) {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: center;
  }
  .row-b__media { grid-column: 1 / span 7; grid-row: 1; aspect-ratio: 3 / 2; }
  .row-b__text { grid-column: 9 / span 4; grid-row: 1; display: flex; flex-direction: column; align-items: flex-start; }
  .rows-b :global(.row-b--flip) .row-b__media { grid-column: 6 / span 7; }
  .rows-b :global(.row-b--flip) .row-b__text { grid-column: 1 / span 4; }

  .row-b__index {
    font-size: var(--fs-title);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.22);
  }
  .row-b__title { margin-top: 1.25rem; font-size: 1.375rem; font-weight: 400; line-height: 1.25; letter-spacing: -0.015em; }
  .row-b__services { margin-top: 0.4rem; font-size: 0.9375rem; color: var(--fg-dim); }
  .row-b__teaser { margin: 1.25rem 0 1.75rem; font-size: 0.9375rem; font-weight: 300; line-height: 1.65; color: var(--fg-muted); }

  /* --- C · Défilement ------------------------------------------------------- */

  .rail-c {
    display: flex;
    gap: 24px;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 70%, rgba(0, 0, 0, 0.15) 100%);
    mask-image: linear-gradient(90deg, #000 70%, rgba(0, 0, 0, 0.15) 100%);
  }
  .rail-c::-webkit-scrollbar { display: none; }
  .rail-c > li { flex: 0 0 clamp(260px, 30vw, 440px); }
  .card-c { display: block; }

  /* --- D · Cartes empilées -------------------------------------------------- */

  .stack-d { display: grid; gap: 2rem; }

  /* Each card pins a little lower than the one before, so they pile up. */
  .card-d {
    position: sticky;
    top: calc(90px + var(--i) * 22px);
    display: block;
    height: min(72vh, 46vw);
    overflow: hidden;
    background: var(--bg-raised);
    box-shadow: 0 -20px 40px rgba(0, 0, 0, 0.35);
  }
  .card-d :global(img) { transition: transform 1.1s var(--spring-smooth); }
  .card-d:hover :global(img) { transform: scale(1.03); }
  .card-d__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.6) 100%);
  }
  .card-d__info {
    position: absolute;
    left: clamp(1.25rem, 3vw, 2.5rem);
    bottom: clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .card-d__index { font-size: var(--fs-label); letter-spacing: var(--tracking-label); color: rgba(255, 255, 255, 0.7); }
  .card-d__title { font-size: clamp(1.25rem, 2.2vw, 2rem); letter-spacing: -0.02em; }
  .card-d__services { font-size: 0.9375rem; color: rgba(255, 255, 255, 0.75); }

  /* --- Phones --------------------------------------------------------------- */

  @media (max-width: 809.98px) {
    .grid-a { grid-template-columns: minmax(0, 1fr); }
    .rows-b :global(.row-b) { grid-template-columns: minmax(0, 1fr); row-gap: 1.25rem; }
    .row-b__media,
    .row-b__text,
    .rows-b :global(.row-b--flip) .row-b__media,
    .rows-b :global(.row-b--flip) .row-b__text { grid-column: auto; grid-row: auto; }
    .rail-c { -webkit-mask-image: none; mask-image: none; }
    .rail-c > li { flex-basis: 78vw; }
    .card-d { height: 62vw; top: calc(70px + var(--i) * 14px); }
  }
</style>
